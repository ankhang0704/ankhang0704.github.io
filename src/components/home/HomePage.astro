---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../ui/Header.astro';
import Footer from '../ui/Footer.astro';
import TechMarquee from '../ui/TechMarquee.astro';
import ExperienceTimeline from '../ui/ExperienceTimeline.astro';
import GridPattern from '../ui/GridPattern.astro';
import CountUp from '../interactive/CountUp.astro';
import CopyEmailButton from '../interactive/CopyEmailButton.astro';
import DecryptedText from '../interactive/DecryptedText.astro';
import { getDictionary } from '../../i18n/utils';

interface Props {
  lang: 'en' | 'vi';
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const dict = getDictionary(lang);

// Query featured projects for this language
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.id.startsWith(`${lang}/`) && p.data.featured)
  .sort((a, b) => a.data.code.localeCompare(b.data.code));

const pageTitle = isVi
  ? 'An Khang | Lập trình viên'
  : 'An Khang | Software Developer';

const pageDesc = isVi
  ? 'An Khang — Lập trình viên phát triển web, mobile và tự động hóa với kinh nghiệm thực tế về IT support.'
  : 'An Khang — Software Developer building web, mobile, and automation tools with hands-on IT support experience.';

const currentPath = isVi ? '/vi/' : '/';
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <Header lang={lang} currentPath={currentPath} />

  <main id="main-content" class="min-h-screen">
    <!-- Hero Section -->
    <section
      id="hero"
      class="min-h-[100dvh] flex items-center relative overflow-x-hidden pt-24 pb-16 bg-bgLight dark:bg-bgDark text-black dark:text-white"
    >
      <GridPattern />

      <div class="container mx-auto px-6 md:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-black dark:bg-white"></span>
            <span class="text-xs font-mono uppercase tracking-[0.25em] opacity-60">
              {isVi ? 'Hồ sơ năng lực · 2026' : 'Portfolio · 2026'}
            </span>
          </div>

          <h1 class="font-display text-5xl sm:text-6xl md:text-8xl font-bold leading-[1.08] mb-8 tracking-tight">
            <span class="block">
              <DecryptedText text="Software" speed={35} maxIterations={12} animateOn="view" />
            </span>
            <span class="block">
              <DecryptedText text="Developer" speed={35} maxIterations={12} animateOn="view" />
              <span class="font-light text-3xl sm:text-4xl md:text-6xl ml-2 sm:ml-4 tracking-tight opacity-75 inline-block">
                · An Khang
              </span>
            </span>
          </h1>

          <p class="font-sans text-xl md:text-2xl font-light max-w-2xl mb-12 opacity-85 leading-relaxed text-neutral-700 dark:text-neutral-300">
            {dict.hero.subtitle}
          </p>

          <!-- CTAs Toolbar -->
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="#projects"
              class="border border-black dark:border-white px-8 py-4 text-sm font-bold uppercase tracking-widest font-mono hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors duration-200 inline-flex items-center justify-center group"
            >
              <span>{dict.hero.viewProjects}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-3 group-hover:translate-x-1.5 transition-transform duration-200"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>

            <a
              href="/my_cv.pdf"
              download="An_Khang_Software_Developer_CV.pdf"
              class="border border-black/30 dark:border-white/30 px-8 py-4 text-sm font-bold uppercase tracking-widest font-mono hover:border-black dark:hover:border-white transition-colors duration-200 inline-flex items-center justify-center group"
            >
              <span>{dict.hero.downloadCV}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-3 group-hover:translate-y-0.5 transition-transform duration-200"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>

            <CopyEmailButton
              lang={lang}
              isVi={isVi}
              class="border border-black/30 dark:border-white/30 px-6 py-4 text-sm font-bold uppercase tracking-widest font-mono hover:border-black dark:hover:border-white transition-colors duration-200"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Infinite Tech Velocity Ticker -->
    <TechMarquee />

    <!-- Engineering Metrics Counter -->
    <section class="border-b border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark py-12 text-black dark:text-white">
      <div class="container mx-auto px-6 md:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6">
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={1847} duration={2} separator="," />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? 'Thuật ngữ FM Dictionary' : 'Specialized FM Terms'}
            </div>
          </div>

          <div class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6">
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={4} duration={1.5} suffix="+" />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? 'Năm học tập & lập trình' : 'Years Study & Code'}
            </div>
          </div>

          <div class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6">
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={5} duration={1.8} suffix="+" />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? 'Công nghệ thành thạo' : 'Core Technologies'}
            </div>
          </div>

          <div class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6">
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={2} duration={1.5} suffix="+" />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? 'Nền tảng đã ship' : 'Production Platforms'}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About / Summary Section -->
    <section
      id="about"
      data-nav-section="about"
      class="scroll-mt-24 py-32 md:py-40 bg-cardLight dark:bg-cardDark border-y border-black/5 dark:border-white/5 relative overflow-x-hidden text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8 relative z-10">
        <div class="max-w-3xl mb-12">
          <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] opacity-50 mb-4">
            {dict.about.label}
          </p>
          <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight">
            {dict.about.title}
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
          <!-- Credentials -->
          <div class="lg:col-span-4 space-y-8">
            <div class="border-t border-black/10 dark:border-white/10 pt-6 space-y-6 font-mono opacity-90">
              <div class="flex items-start gap-3.5">
                <span class="w-2 h-2 bg-black dark:bg-white mt-2 flex-shrink-0"></span>
                <div>
                  <span class="text-base sm:text-lg font-bold block leading-snug">{dict.about.hospital}</span>
                  <span class="opacity-80 text-xs sm:text-sm block mt-0.5">{dict.about.hospitalRole}</span>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="w-2 h-2 bg-black dark:bg-white mt-2 flex-shrink-0"></span>
                <div>
                  <span class="text-base sm:text-lg font-bold block leading-snug">{dict.about.degree}</span>
                  {dict.about.degreeRole && (
                    <span class="opacity-80 text-xs sm:text-sm block mt-0.5">{dict.about.degreeRole}</span>
                  )}
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="w-2 h-2 bg-black dark:bg-white mt-2 flex-shrink-0"></span>
                <div>
                  <span class="text-base sm:text-lg font-bold block leading-snug">{dict.about.fm}</span>
                  <span class="opacity-80 text-xs sm:text-sm block mt-0.5">{dict.about.fmRole}</span>
                </div>
              </div>
            </div>

            <div class="flex flex-wrap gap-2.5 pt-2">
              <span class="border border-black/20 dark:border-white/20 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark">
                {dict.about.tag1}
              </span>
              <span class="border border-black/20 dark:border-white/20 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark">
                {dict.about.tag2}
              </span>
            </div>
          </div>

          <!-- Narrative -->
          <div class="lg:col-span-8 space-y-10 lg:border-l lg:border-black/10 dark:lg:border-white/10 lg:pl-12">
            <p class="font-display text-2xl sm:text-3xl md:text-4xl font-light leading-relaxed tracking-tight text-neutral-800 dark:text-neutral-200">
              {dict.about.lead}
            </p>
            <div class="space-y-6 text-lg sm:text-xl font-light opacity-85 leading-relaxed border-t border-black/10 dark:border-white/10 pt-8 text-neutral-700 dark:text-neutral-300">
              <p>{dict.about.p1}</p>
              <p>{dict.about.p2}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills / Capabilities Section -->
    <section id="skills" class="scroll-mt-24 py-32 md:py-40 overflow-x-hidden relative bg-bgLight dark:bg-bgDark text-black dark:text-white">
      <div class="container mx-auto px-6 md:px-8">
        <div class="max-w-3xl mb-16">
          <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] opacity-50 mb-4">
            {dict.skills.label}
          </p>
          <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight">
            {dict.skills.title}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl">
          <!-- Column 1: Software & Applications -->
          <div class="h-full p-8 sm:p-10 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark flex flex-col justify-between hover:border-black dark:hover:border-white transition-colors duration-300">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-mono uppercase tracking-widest border border-black/20 dark:border-white/20 px-3 py-1.5 opacity-80 font-medium">Primary</span>
              </div>
              <h3 class="font-display text-2xl sm:text-3xl font-bold mb-4">{dict.skills.devTitle}</h3>
              <p class="font-light opacity-85 text-base sm:text-lg leading-relaxed mb-8">{dict.skills.devDesc}</p>
            </div>
            <div class="pt-6 border-t border-black/5 dark:border-white/5">
              <div class="text-xs font-mono uppercase tracking-widest opacity-60 mb-3.5 font-bold">{dict.skills.stackLabel}</div>
              <div class="flex flex-wrap gap-2">
                {['Django', 'Flutter', 'Python', 'Dart', 'WordPress', 'JavaScript'].map((tech) => (
                  <span class="text-xs font-mono px-3 py-1 border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Column 2: Architecture & Data -->
          <div class="h-full p-8 sm:p-10 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark flex flex-col justify-between hover:border-black dark:hover:border-white transition-colors duration-300">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-mono uppercase tracking-widest border border-black/20 dark:border-white/20 px-3 py-1.5 opacity-80 font-medium">Practical</span>
              </div>
              <h3 class="font-display text-2xl sm:text-3xl font-bold mb-4">{dict.skills.cloudTitle}</h3>
              <p class="font-light opacity-85 text-base sm:text-lg leading-relaxed mb-8">{dict.skills.cloudDesc}</p>
            </div>
            <div class="pt-6 border-t border-black/5 dark:border-white/5">
              <div class="text-xs font-mono uppercase tracking-widest opacity-60 mb-3.5 font-bold">
                {isVi ? 'Dữ liệu & Tự động hóa' : 'Data & Automation'}
              </div>
              <div class="flex flex-wrap gap-2">
                {['Firebase', 'Hive', 'Cloudflare Workers', 'FAISS', 'Git'].map((tech) => (
                  <span class="text-xs font-mono px-3 py-1 border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Column 3: Systems & Operations -->
          <div class="h-full p-8 sm:p-10 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark flex flex-col justify-between hover:border-black dark:hover:border-white transition-colors duration-300">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-mono uppercase tracking-widest border border-black/20 dark:border-white/20 px-3 py-1.5 opacity-80 font-medium">
                  {dict.skills.supportLabel}
                </span>
              </div>
              <h3 class="font-display text-2xl sm:text-3xl font-bold mb-4">{dict.skills.infraTitle}</h3>
              <p class="font-light opacity-85 text-base sm:text-lg leading-relaxed mb-8">{dict.skills.infraDesc}</p>
            </div>
            <div class="pt-6 border-t border-black/5 dark:border-white/5">
              <div class="text-xs font-mono uppercase tracking-widest opacity-60 mb-3.5 font-bold">
                {isVi ? 'Vận hành & Hỗ trợ' : 'Operations & Support'}
              </div>
              <div class="flex flex-wrap gap-2">
                {['IT Helpdesk', 'Hardware Support', 'Network Troubleshooting', 'User Support', 'Documentation'].map((tech) => (
                  <span class="text-xs font-mono px-3 py-1 border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Showcase Section -->
    <section
      id="projects"
      data-nav-section="projects"
      class="relative overflow-x-hidden border-y border-black/5 bg-cardLight py-32 dark:border-white/5 dark:bg-cardDark md:py-40 text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8">
        <div class="max-w-3xl mb-16 md:mb-20">
          <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] opacity-50 mb-4">
            {dict.projects.label}
          </p>
          <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight">
            {dict.projects.title}
          </h2>
        </div>

        <!-- Featured Projects List -->
        <div class="space-y-16 lg:space-y-24">
          {featuredProjects.map((project, idx) => {
            const caseStudyUrl = isVi ? `/vi${project.data.canonicalPath}` : project.data.canonicalPath;
            return (
              <article class="border border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark p-6 md:p-10 transition-colors duration-300 hover:border-black/30 dark:hover:border-white/30">
                <!-- Top Engineering Viewport Bar -->
                <div class="flex flex-wrap items-center justify-between gap-3 pb-6 mb-8 border-b border-black/10 dark:border-white/10 text-xs font-mono">
                  <div class="flex items-center gap-3">
                    <span class="font-bold tracking-widest px-2.5 py-1 bg-black text-white dark:bg-white dark:text-black">
                      {project.data.code}
                    </span>
                    <span class="uppercase tracking-wider opacity-60 font-semibold">
                      {project.data.category}
                    </span>
                  </div>
                  <div class="flex items-center gap-4">
                    <span class="px-2.5 py-1 border border-black/20 dark:border-white/20 tracking-wider text-[11px] opacity-80">
                      {project.data.status}
                    </span>
                    <span class="opacity-50">{project.data.year}</span>
                  </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
                  <!-- Project Info -->
                  <div class="lg:col-span-7 space-y-6">
                    <h3 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight">
                      <a href={caseStudyUrl} class="hover:underline">
                        {project.data.title}
                      </a>
                    </h3>

                    <p class="text-lg md:text-xl font-light opacity-85 leading-relaxed text-neutral-700 dark:text-neutral-300">
                      {project.data.summary}
                    </p>

                    <!-- Specs -->
                    {project.data.specs && project.data.specs.length > 0 && (
                      <div class="grid grid-cols-2 gap-3 pt-2">
                        {project.data.specs.map((spec) => (
                          <div class="flex items-center gap-2 text-xs font-mono opacity-80">
                            <span class="w-1.5 h-1.5 bg-black dark:bg-white"></span>
                            <span>{spec}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    <!-- Tech Stack Pills -->
                    <div class="pt-2">
                      <div class="text-[11px] font-mono uppercase tracking-widest opacity-50 mb-2 font-bold">
                        {isVi ? 'Công nghệ chính' : 'Technology Stack'}
                      </div>
                      <div class="flex flex-wrap gap-2">
                        {project.data.techStack.map((tech) => (
                          <span class="text-xs font-mono px-3 py-1 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark">
                            {tech}
                          </span>
                        ))}
                      </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center gap-4 pt-4">
                      <a
                        href={caseStudyUrl}
                        class="border border-black dark:border-white px-6 py-3 text-xs font-bold uppercase tracking-widest font-mono hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors duration-200 inline-flex items-center gap-2 group"
                      >
                        <span>{dict.projects.viewCaseStudy}</span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="group-hover:translate-x-1 transition-transform"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14"></path>
                          <path d="m12 5 7 7-7 7"></path>
                        </svg>
                      </a>

                      {project.data.externalHref && (
                        <a
                          href={project.data.externalHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="border border-black/30 dark:border-white/30 px-5 py-3 text-xs font-bold uppercase tracking-widest font-mono hover:border-black dark:hover:border-white transition-colors duration-200 inline-flex items-center gap-1.5 opacity-80 hover:opacity-100"
                        >
                          <span>{project.data.externalLabel || dict.projects.viewSource}</span>
                        </a>
                      )}

                      {project.data.secondaryExternalHref && (
                        <a
                          href={project.data.secondaryExternalHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="border border-black/20 dark:border-white/20 px-5 py-3 text-xs font-bold uppercase tracking-widest font-mono hover:border-black dark:hover:border-white transition-colors duration-200 inline-flex items-center gap-1.5 opacity-70 hover:opacity-100"
                        >
                          <span>{project.data.secondaryExternalLabel}</span>
                        </a>
                      )}
                    </div>
                  </div>

                  <!-- Cover Image Viewport -->
                  {project.data.image && (
                    <div class="lg:col-span-5">
                      <a href={caseStudyUrl} class="block group overflow-hidden border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark">
                        <div class="aspect-[16/10] overflow-hidden relative">
                          <img
                            src={project.data.image}
                            alt={project.data.title}
                            loading={idx === 0 ? "eager" : "lazy"}
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                        </div>
                      </a>
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Experience Timeline Section -->
    <section id="experience" data-nav-section="experience" class="scroll-mt-24 py-32 md:py-40 relative overflow-x-hidden bg-bgLight dark:bg-bgDark text-black dark:text-white">
      <div class="container mx-auto px-6 md:px-8">
        <div class="max-w-3xl mb-20">
          <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] opacity-50 mb-4">
            {dict.timeline.label}
          </p>
          <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight">
            {dict.timeline.title}
          </h2>
        </div>

        <ExperienceTimeline lang={lang} />
      </div>
    </section>

    <!-- All Projects Directory CTA Section -->
    <section
      id="all-projects"
      data-nav-section="projects-index"
      class="py-24 md:py-32 bg-cardLight dark:bg-cardDark border-y border-black/5 dark:border-white/5 relative overflow-x-hidden text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7">
          <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] opacity-50 mb-3">
            {dict.allProjects.label}
          </p>
          <h2 class="font-display text-4xl md:text-6xl font-bold mb-6 tracking-tight">
            {dict.allProjects.title}
          </h2>
          <p class="font-light text-xl leading-relaxed opacity-85 max-w-2xl text-neutral-700 dark:text-neutral-300">
            {dict.allProjects.desc}
          </p>
        </div>

        <div class="lg:col-span-5 lg:border-l lg:border-black/10 dark:lg:border-white/10 lg:pl-10">
          <a
            href={isVi ? '/vi/projects/' : '/projects/'}
