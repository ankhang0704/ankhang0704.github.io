---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../ui/Header.astro";
import Footer from "../ui/Footer.astro";
import TechMarquee from "../ui/TechMarquee.astro";
import ExperienceTimeline from "../ui/ExperienceTimeline.astro";
import GridPattern from "../ui/GridPattern.astro";
import CountUp from "../interactive/CountUp.astro";
import DecryptedText from "../interactive/DecryptedText.astro";
import SpotlightCard from "../interactive/SpotlightCard.astro";
import MagneticButton from "../interactive/MagneticButton.astro";
import RevealOnScroll from "../interactive/RevealOnScroll.astro";
import { getDictionary } from "../../i18n/utils";

interface Props {
  lang: "en" | "vi";
}

const { lang } = Astro.props;
const isVi = lang === "vi";
const dict = getDictionary(lang);

// Query featured projects for this language
const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.id.startsWith(`${lang}/`) && p.data.featured)
  .sort((a, b) => a.data.code.localeCompare(b.data.code));

const pageTitle = isVi
  ? "An Khang | Lập trình viên"
  : "An Khang | Software Developer";

const pageDesc = isVi
  ? "An Khang — Lập trình viên phát triển web, mobile và tự động hóa với kinh nghiệm thực tế về IT support."
  : "An Khang — Software Developer building web, mobile, and automation tools with hands-on IT support experience.";

const currentPath = isVi ? "/vi/" : "/";
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <Header lang={lang} currentPath={currentPath} />

  <main id="main-content" class="min-h-screen">
    <!-- Hero Section -->
    <section
      id="hero"
      class="min-h-[100svh] flex items-center relative overflow-x-clip pt-16 pb-8"
    >
      <GridPattern />
      <div class="container mx-auto px-6 md:px-8 relative z-10">
        <h1 class="font-display text-5xl md:text-8xl font-bold leading-[1.1] mb-6 text-black dark:text-white">
          <span class="block overflow-hidden pb-2">
            <span class="hero-title-line block">
              <DecryptedText
                text="Software"
                speed={35}
                maxIterations={12}
                animateOn="mount"
              />
            </span>
          </span>
          <span class="block overflow-hidden pb-2">
            <span class="hero-title-line block">
              <DecryptedText
                text="Developer"
                speed={35}
                maxIterations={12}
                animateOn="mount"
              />
              <span class="font-light text-4xl sm:text-5xl md:text-7xl ml-3 tracking-tight opacity-80 inline-block">
                · An Khang
              </span>
            </span>
          </span>
        </h1>
        <p class="hero-subtitle text-xl font-light max-w-2xl mb-12 opacity-80 leading-relaxed text-black dark:text-white">
          {dict.hero.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <MagneticButton strength={0.16} class="w-full sm:w-auto">
            <a
              href="#projects"
              class="hero-cta-btn min-h-11 border border-black dark:border-white px-8 py-4 text-sm font-bold uppercase tracking-widest hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors duration-200 inline-flex items-center justify-center w-full sm:w-auto group/btn1 text-black dark:text-white font-mono"
            >
              <span>{dict.hero.viewProjects}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-3 transition-transform duration-300 group-hover/btn1:translate-x-2"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </MagneticButton>

          <MagneticButton strength={0.16} class="w-full sm:w-auto">
            <a
              href={isVi ? "/vi/cv/" : "/cv/"}
              data-astro-prefetch="tap"
              class="min-h-11 border border-black/30 dark:border-white/30 px-8 py-4 text-sm font-bold uppercase tracking-widest hover:border-black dark:hover:border-white transition-colors duration-200 inline-flex items-center justify-center w-full sm:w-auto text-black dark:text-white font-mono"
            >
              <span>{isVi ? "Xem CV" : "View Resume"}</span>
            </a>
          </MagneticButton>
        </div>
      </div>
    </section>

    <!-- Infinite Tech Velocity Ticker -->
    <TechMarquee />

    <!-- Engineering Metrics Counter -->
    <section class="border-b border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark py-12 text-black dark:text-white">
      <div class="container mx-auto px-6 md:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <RevealOnScroll
            delay={50}
            class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6"
          >
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={4} duration={1.5} />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? "Năm học Đại học" : "Years of Study"}
            </div>
          </RevealOnScroll>
          <RevealOnScroll
            delay={120}
            class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6"
          >
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={2} duration={1.5} suffix="+" />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? "Dự án hoàn thiện" : "Shipped Projects"}
            </div>
          </RevealOnScroll>
          <RevealOnScroll
            delay={190}
            class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6"
          >
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={5} duration={1.8} suffix="+" />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? "Công nghệ thành thạo" : "Core Technologies"}
            </div>
          </RevealOnScroll>
          <RevealOnScroll
            delay={260}
            class="border-l border-black/15 dark:border-white/15 pl-4 sm:pl-6"
          >
            <div class="text-3xl sm:text-4xl md:text-5xl font-bold font-mono tracking-tight text-black dark:text-white">
              <CountUp to={2} duration={1.5} />
            </div>
            <div class="mt-2 text-xs font-mono uppercase tracking-widest opacity-60">
              {isVi ? "Nền tảng đã ship" : "Platforms Shipped"}
            </div>
          </RevealOnScroll>
        </div>
      </div>
    </section>

    <!-- About / Summary Section -->
    <section
      id="about"
      class="scroll-mt-12 py-32 md:py-40 bg-cardLight dark:bg-cardDark border-y border-black/5 dark:border-white/5 relative overflow-x-clip text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8 relative z-10">
        <RevealOnScroll delay={50} class="max-w-3xl mb-12">
          <h2 class="font-display text-4xl md:text-6xl font-bold">
            {dict.about.title}
          </h2>
        </RevealOnScroll>
        <RevealOnScroll delay={120}>
          <div class="summary-container grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
            <div class="summary-credentials lg:col-span-4 space-y-8">
              <div class="border-t border-black/10 dark:border-white/10 pt-6 space-y-5 font-mono opacity-90">
                <div class="flex items-start gap-3.5">
                  <span class="w-2 h-2 bg-black dark:bg-white mt-2 flex-shrink-0" />
                  <div>
                    <span class="text-base sm:text-lg font-bold block leading-snug">
                      {dict.about.hospital}
                    </span>
                    <span class="opacity-80 text-xs sm:text-sm block mt-0.5">
                      {dict.about.hospitalRole}
                    </span>
                  </div>
                </div>
                <div class="flex items-start gap-3.5">
                  <span class="w-2 h-2 bg-black dark:bg-white mt-2 flex-shrink-0" />
                  <div>
                    <span class="text-base sm:text-lg font-bold block leading-snug">
                      {dict.about.degree}
                    </span>
                    {dict.about.degreeRole && (
                      <span class="opacity-80 text-xs sm:text-sm block mt-0.5">
                        {dict.about.degreeRole}
                      </span>
                    )}
                  </div>
                </div>
                <div class="flex items-start gap-3.5">
                  <span class="w-2 h-2 bg-black dark:bg-white mt-2 flex-shrink-0" />
                  <div>
                    <span class="text-base sm:text-lg font-bold block leading-snug">
                      {dict.about.fm}
                    </span>
                    <span class="opacity-80 text-xs sm:text-sm block mt-0.5">
                      {dict.about.fmRole}
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap gap-2.5 pt-2">
                <span class="border border-black/20 dark:border-white/20 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark">
                  {dict.about.tag1}
                </span>
                <span class="border border-black/20 dark:border-white/20 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark">
                  {dict.about.tag2}
                </span>
              </div>
            </div>

            <div class="summary-narrative lg:col-span-8 space-y-8 lg:border-l lg:border-black/10 dark:lg:border-white/10 lg:pl-12">
              <p class="font-display text-3xl sm:text-4xl md:text-5xl font-light leading-relaxed text-left tracking-tight">
                {dict.about.lead}
              </p>
            </div>
          </div>
        </RevealOnScroll>
      </div>
    </section>

    <!-- Projects Section (Flagship Split + Balanced Two-Column Showcase) -->
    <section
      id="projects"
      data-nav-section="projects"
      class="scroll-mt-12 relative overflow-x-clip border-b border-black/10 bg-bgLight py-28 dark:border-white/10 dark:bg-bgDark md:py-36 text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8">
        <RevealOnScroll class="mb-12 max-w-3xl md:mb-16">
          <h2 class="font-display text-4xl font-bold md:text-6xl">
            {dict.projects.title}
          </h2>
        </RevealOnScroll>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {featuredProjects.map((project, index) => {
            const isFlagship = index === 0;
            const caseStudyUrl = isVi
              ? `/vi${project.data.canonicalPath}`
              : project.data.canonicalPath;
            const keySpecs = (project.data.specs ?? []).slice(0, 3);

            return (
              <RevealOnScroll
                class={`${isFlagship ? "md:col-span-2" : ""} h-full flex flex-col`}
                delay={index * 90}
              >
                <SpotlightCard class="group h-full border border-black/10 bg-cardLight dark:border-white/10 dark:bg-cardDark scroll-mt-24 hover:border-black dark:hover:border-white transition-colors duration-300">
                  <article
                    id={project.data.code.toLowerCase()}
                    class={
                      isFlagship
                        ? "grid grid-cols-1 lg:grid-cols-12 h-full"
                        : "flex flex-col h-full"
                    }
                  >
                    {/* Clean Editorial Cover Artwork */}
                    <a
                      href={caseStudyUrl}
                      data-astro-prefetch="tap"
                      aria-label={project.data.title}
                      class={
                        isFlagship
                          ? "block lg:col-span-7 relative overflow-hidden border-b lg:border-b-0 lg:border-r border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark"
                          : "block relative overflow-hidden border-b border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark"
                      }
                    >
                      <div
                        class={
                          isFlagship
                            ? "aspect-[16/10] lg:h-full w-full overflow-hidden"
                            : "aspect-[16/10] w-full overflow-hidden"
                        }
                      >
                        {project.data.image ? (
                          <img
                            src={project.data.image}
                            alt={project.data.title}
                            width="1280"
                            height="801"
                            loading={isFlagship ? "eager" : "lazy"}
                            decoding="async"
                            class="w-full h-full object-cover transition-transform duration-500 ease-out [@media(hover:hover)_and_(pointer:fine)]:group-hover:scale-[1.03]"
                          />
                        ) : (
                          <div class="flex h-full min-h-[220px] flex-col items-center justify-center gap-2 font-mono text-xs uppercase tracking-[0.25em] opacity-60">
                            <span class="text-3xl font-bold tracking-tight opacity-75">
                              {project.data.code}
                            </span>
                            <span>Documented Repository</span>
                          </div>
                        )}
                      </div>
                    </a>

                    {/* Card Content & Single Primary Action */}
                    <div
                      class={
                        isFlagship
                          ? "lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between gap-8"
                          : "p-6 sm:p-8 flex-1 flex flex-col justify-between gap-6"
                      }
                    >
                      <div>
                        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs uppercase tracking-widest opacity-65">
                          <span class="inline-block w-1.5 h-1.5 bg-current" />
                          <span class="font-bold opacity-100">
                            {project.data.code}
                          </span>
                          {project.data.status && (
                            <>
                              <span aria-hidden="true">·</span>
                              <span>{project.data.status}</span>
                            </>
                          )}
                        </div>

                        <h3
                          class={
                            isFlagship
                              ? "mt-3 font-display text-3xl sm:text-4xl font-bold tracking-tight"
                              : "mt-3 font-display text-2xl sm:text-3xl font-bold tracking-tight"
                          }
                        >
                          <a
                            href={caseStudyUrl}
                            data-astro-prefetch="tap"
                            class="hover:underline"
                          >
                            {project.data.title}
                          </a>
                        </h3>

                        <p class="mt-3 max-w-[54ch] text-base font-light leading-relaxed opacity-80">
                          {project.data.summary}
                        </p>

                        {keySpecs.length > 0 && (
                          <ul class="mt-5 pt-4 border-t border-black/10 dark:border-white/10 flex flex-wrap gap-x-4 gap-y-1.5 font-mono text-xs opacity-70">
                            {keySpecs.map((spec) => (
                              <li class="inline-flex items-center gap-1.5">
                                <span
                                  aria-hidden="true"
                                  class="w-1 h-1 bg-current opacity-60"
                                />
                                <span>{spec}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>

                      <div class="flex flex-wrap items-center gap-4 pt-1">
                        <a
                          href={caseStudyUrl}
                          data-astro-prefetch="tap"
                          class="min-h-11 inline-flex items-center gap-2.5 border border-black px-5 py-2.5 text-xs font-bold uppercase tracking-widest transition-colors hover:bg-black hover:text-white dark:border-white dark:hover:bg-white dark:hover:text-black font-mono group/cta"
                        >
                          <span>{dict.projects.viewCaseStudy}</span>
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="15"
                            height="15"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="transition-transform duration-200 [@media(hover:hover)_and_(pointer:fine)]:group-hover/cta:translate-x-1"
                            aria-hidden="true"
                          >
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                          </svg>
                        </a>

                        {project.data.externalHref && (
                          <a
                            href={project.data.externalHref}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="min-h-11 inline-flex items-center font-mono text-xs font-medium uppercase tracking-wider opacity-75 hover:opacity-100 hover:underline transition-opacity"
                          >
                            {project.data.externalLabel ||
                              dict.projects.viewSource}
                          </a>
                        )}

                        {project.data.secondaryExternalHref && (
                          <a
                            href={project.data.secondaryExternalHref}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="min-h-11 inline-flex items-center font-mono text-xs font-medium uppercase tracking-wider opacity-75 hover:opacity-100 hover:underline transition-opacity"
                          >
                            {project.data.secondaryExternalLabel ||
                              dict.projects.viewSource}
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                </SpotlightCard>
              </RevealOnScroll>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section
      id="skills"
      class="scroll-mt-12 py-32 md:py-40 overflow-x-clip relative text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8">
        <RevealOnScroll delay={50} class="max-w-3xl mb-16">
          <h2 class="font-display text-4xl md:text-6xl font-bold">
            {dict.skills.title}
          </h2>
        </RevealOnScroll>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl">
          <!-- Column 1: Software & Applications -->
          <RevealOnScroll delay={80}>
            <SpotlightCard class="h-full p-8 sm:p-10 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark flex flex-col justify-between hover:border-black dark:hover:border-white transition-[border-color] duration-300">
              <div class="mb-8">
                <div class="flex items-center justify-between mb-6">
                  <span class="text-xs font-mono uppercase tracking-widest border border-black/20 dark:border-white/20 px-3 py-1.5 opacity-80 font-medium">
                    Primary
                  </span>
                </div>
                <h3 class="font-display text-3xl sm:text-4xl font-bold">
                  {dict.skills.devTitle}
                </h3>
              </div>
              <div class="pt-6 border-t border-black/10 dark:border-white/10">
                <div class="flex flex-wrap gap-2.5">
                  {[
                    "Django",
                    "Flutter",
                    "Python",
                    "Dart",
                    "WordPress",
                    "JavaScript",
                  ].map((tech) => (
                    <span class="border border-black/15 dark:border-white/15 px-3 py-1.5 text-xs font-mono uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark hover:border-black dark:hover:border-white hover:opacity-100 transition-colors duration-200">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </SpotlightCard>
          </RevealOnScroll>

          <!-- Column 2: Architecture & Data -->
          <RevealOnScroll delay={160}>
            <SpotlightCard class="h-full p-8 sm:p-10 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark flex flex-col justify-between hover:border-black dark:hover:border-white transition-[border-color] duration-300">
              <div class="mb-8">
                <div class="flex items-center justify-between mb-6">
                  <span class="text-xs font-mono uppercase tracking-widest border border-black/20 dark:border-white/20 px-3 py-1.5 opacity-80 font-medium">
                    Practical
                  </span>
                </div>
                <h3 class="font-display text-3xl sm:text-4xl font-bold">
                  {dict.skills.cloudTitle}
                </h3>
              </div>
              <div class="pt-6 border-t border-black/10 dark:border-white/10">
                <div class="flex flex-wrap gap-2.5">
                  {[
                    "Firebase",
                    "Hive",
                    "Cloudflare Workers",
                    "FAISS",
                    "HuggingFace",
                    "Git",
                  ].map((tech) => (
                    <span class="border border-black/15 dark:border-white/15 px-3 py-1.5 text-xs font-mono uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark hover:border-black dark:hover:border-white hover:opacity-100 transition-colors duration-200">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </SpotlightCard>
          </RevealOnScroll>

          <!-- Column 3: Systems & Operations -->
          <RevealOnScroll delay={240}>
            <SpotlightCard class="h-full p-8 sm:p-10 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark flex flex-col justify-between hover:border-black dark:hover:border-white transition-[border-color] duration-300">
              <div class="mb-8">
                <div class="flex items-center justify-between mb-6">
                  <span class="text-xs font-mono uppercase tracking-widest border border-black/20 dark:border-white/20 px-3 py-1.5 opacity-80 font-medium">
                    {dict.skills.supportLabel}
                  </span>
                </div>
                <h3 class="font-display text-3xl sm:text-4xl font-bold">
                  {dict.skills.infraTitle}
                </h3>
              </div>
              <div class="pt-6 border-t border-black/10 dark:border-white/10">
                <div class="flex flex-wrap gap-2.5">
                  {[
                    "IT Helpdesk",
                    "Hardware Support",
                    "Network Troubleshooting",
                    "User Support",
                    "Documentation",
                  ].map((tech) => (
                    <span class="border border-black/15 dark:border-white/15 px-3 py-1.5 text-xs font-mono uppercase tracking-wider opacity-80 bg-bgLight dark:bg-bgDark hover:border-black dark:hover:border-white hover:opacity-100 transition-colors duration-200">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </SpotlightCard>
          </RevealOnScroll>
        </div>
      </div>
    </section>

    <!-- Experience Timeline Section -->
    <section
      id="experience"
      class="scroll-mt-12 py-32 md:py-40 relative overflow-x-clip text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8">
        <RevealOnScroll delay={50} class="max-w-3xl mb-20">
          <h2 class="font-display text-4xl md:text-6xl font-bold">
            {dict.timeline.title}
          </h2>
        </RevealOnScroll>
        <RevealOnScroll delay={120}>
          <ExperienceTimeline lang={lang} />
        </RevealOnScroll>
      </div>
    </section>

    <!-- All Projects Index Showcase Banner -->
    <section
      id="all-projects"
      data-nav-section="projects-index"
      class="py-24 md:py-32 bg-cardLight dark:bg-cardDark border-y border-black/5 dark:border-white/5 relative overflow-x-clip text-black dark:text-white"
    >
      <div class="container mx-auto px-6 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        <RevealOnScroll class="lg:col-span-7">
          <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight">
            {dict.allProjects.title}
          </h2>
        </RevealOnScroll>
        <div class="lg:col-span-5 lg:border-l lg:border-black/10 dark:lg:border-white/10 lg:pl-10">
          <a
            href={isVi ? "/vi/projects/" : "/projects/"}
            data-astro-prefetch="tap"
            class="border border-black dark:border-white px-8 py-4 text-sm font-bold uppercase tracking-widest hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors inline-flex items-center justify-between gap-3 w-full font-mono"
          >
            <span>{dict.allProjects.cta}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
