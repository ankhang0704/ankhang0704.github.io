---
interface Props {
  text: string;
  speed?: number;
  maxIterations?: number;
  characters?: string;
  class?: string;
  parentClass?: string;
  animateOn?: "view" | "hover" | "mount";
  hoverReplay?: boolean;
}

const {
  text,
  speed = 40,
  maxIterations = 10,
  characters = "0123456789ABCDEF!@#$%&*+/?~",
  class: className = "",
  parentClass = "",
  animateOn = "mount",
  hoverReplay = true,
} = Astro.props;
---

<span
  class={`inline-block select-none decrypted-text-container cursor-default ${parentClass}`}
  data-text={text}
  data-speed={speed}
  data-max-iterations={maxIterations}
  data-characters={characters}
  data-animate-on={animateOn}
  data-hover-replay={hoverReplay.toString()}
  aria-label={text}
>
  <span class={`decrypted-text-target ${className}`}>{text}</span>
</span>

<script>
  const activeIntervals = new Set<number>();
  const activeObservers = new Set<IntersectionObserver>();

  function cleanupDecryptedText() {
    activeIntervals.forEach((id) => clearInterval(id));
    activeIntervals.clear();
    activeObservers.forEach((observer) => observer.disconnect());
    activeObservers.clear();
  }

  function initDecryptedText() {
    cleanupDecryptedText();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const isLangSwitch =
      sessionStorage.getItem("lang_switch_freeze_anim") === "true";

    const containers = Array.from(
      document.querySelectorAll<HTMLElement>(".decrypted-text-container")
    );
    if (!containers.length) return;

    // Pre-measure mount containers in one read pass before writing locked widths
    const premeasuredWidths = new Map<HTMLElement, number>();
    containers.forEach((container) => {
      if (
        container.dataset.decryptedInitialized !== "true" &&
        (container.dataset.animateOn || "view") === "mount" &&
        !isLangSwitch
      ) {
        premeasuredWidths.set(
          container,
          Math.ceil(container.getBoundingClientRect().width)
        );
      }
    });

    containers.forEach((container) => {
      if (container.dataset.decryptedInitialized === "true") return;
      container.dataset.decryptedInitialized = "true";

      const text = container.dataset.text || "";
      const speed = parseInt(container.dataset.speed || "40", 10);
      const maxIterations = parseInt(
        container.dataset.maxIterations || "10",
        10
      );
      const characters =
        container.dataset.characters || "0123456789ABCDEF!@#$%&*+/?~";
      const animateOn = container.dataset.animateOn || "view";
      const hoverReplay = container.dataset.hoverReplay !== "false";
      const target = container.querySelector(".decrypted-text-target");

      if (!target || !text) return;

      let isAnimating = false;
      let intervalId: number | undefined;

      const clearWidthLock = () => {
        container.style.minWidth = "";
        container.style.width = "";
      };

      const runScramble = (measuredWidth?: number) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;
        if (isAnimating) return;
        isAnimating = true;

        const width =
          measuredWidth ?? Math.ceil(container.getBoundingClientRect().width);
        if (width > 0) {
          const locked = `${width}px`;
          container.style.minWidth = locked;
          container.style.width = locked;
        }

        let iteration = 0;
        if (intervalId !== undefined) {
          clearInterval(intervalId);
          activeIntervals.delete(intervalId);
        }

        intervalId = window.setInterval(() => {
          iteration += 1;
          const progress = iteration / maxIterations;
          const revealedCount = Math.floor(progress * text.length);

          if (iteration >= maxIterations) {
            target.textContent = text;
            clearInterval(intervalId);
            if (intervalId !== undefined) activeIntervals.delete(intervalId);
            intervalId = undefined;
            clearWidthLock();
            isAnimating = false;
            return;
          }

          const scrambled = text
            .split("")
            .map((char, index) => {
              if (char === " " || char === "\n") return char;
              if (index < revealedCount) return text[index];
              return characters[Math.floor(Math.random() * characters.length)];
            })
            .join("");

          target.textContent = scrambled;
        }, speed);

        activeIntervals.add(intervalId);
      };

      if (animateOn === "mount") {
        if (!isLangSwitch) {
          runScramble(premeasuredWidths.get(container));
        } else {
          target.textContent = text;
        }
      } else if (animateOn === "hover") {
        container.addEventListener("mouseenter", () => runScramble());
      } else {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              runScramble();
              observer.disconnect();
              activeObservers.delete(observer);
            }
          },
          { threshold: 0.05 }
        );
        activeObservers.add(observer);
        observer.observe(container);
      }

      if (hoverReplay && animateOn !== "hover") {
        container.addEventListener("mouseenter", () => runScramble());
      }
    });
  }

  document.addEventListener("astro:before-swap", cleanupDecryptedText);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDecryptedText, {
      once: true,
    });
  } else {
    initDecryptedText();
  }
  document.addEventListener("astro:after-swap", initDecryptedText);
</script>
