---
interface Props {
  to: number;
  from?: number;
  duration?: number;
  prefix?: string;
  suffix?: string;
  separator?: string;
  decimals?: number;
  class?: string;
}

const {
  to,
  from = 0,
  duration = 2,
  prefix = "",
  suffix = "",
  separator = ",",
  decimals = 0,
  class: className = "",
} = Astro.props;

// Server-rendered static fallback: accessible, SEO friendly, never freezes at 0
const initialFormatted = to
  .toLocaleString("en-US", {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  })
  .replace(/,/g, separator);
---

<span
  class={`inline-block font-mono tabular-nums count-up-target ${className}`}
  data-to={to}
  data-from={from}
  data-duration={duration}
  data-prefix={prefix}
  data-suffix={suffix}
  data-separator={separator}
  data-decimals={decimals}
  aria-label={`${prefix}${initialFormatted}${suffix}`}
>
  <span class="count-up-value">
    {prefix}
    {initialFormatted}
    {suffix}
  </span>
</span>

<script>
  const activeRafs = new Set<number>();
  const activeObservers = new Set<IntersectionObserver>();

  function cleanupCountUps() {
    activeRafs.forEach((id) => cancelAnimationFrame(id));
    activeRafs.clear();
    activeObservers.forEach((observer) => observer.disconnect());
    activeObservers.clear();
  }

  function initCountUps() {
    cleanupCountUps();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const elements = document.querySelectorAll<HTMLElement>(
      ".count-up-target:not([data-counted])"
    );
    if (!elements.length) return;

    const isLangSwitch =
      sessionStorage.getItem("lang_switch_freeze_anim") === "true";

    // If switching language, keep final static numbers without re-animating
    if (isLangSwitch) {
      elements.forEach((el) => {
        el.setAttribute("data-counted", "true");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          observer.unobserve(el);
          el.setAttribute("data-counted", "true");

          const to = parseFloat(el.dataset.to || "0");
          const from = parseFloat(el.dataset.from || "0");
          const duration = parseFloat(el.dataset.duration || "2") * 1000;
          const prefix = el.dataset.prefix || "";
          const suffix = el.dataset.suffix || "";
          const separator = el.dataset.separator || ",";
          const decimals = parseInt(el.dataset.decimals || "0", 10);
          const valEl = el.querySelector(".count-up-value");
          if (!valEl) return;

          const formatter = new Intl.NumberFormat("en-US", {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });
          const formatValue = (num: number) => {
            const base = formatter.format(num);
            return separator === "," ? base : base.replace(/,/g, separator);
          };

          let start: number | null = null;
          let rafId: number | null = null;

          function step(timestamp: number) {
            if (rafId !== null) {
              activeRafs.delete(rafId);
              rafId = null;
            }
            if (start === null) start = timestamp;
            const progress =
              duration > 0 ? Math.min((timestamp - start) / duration, 1) : 1;
            const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            const current = from + (to - from) * eased;

            valEl!.textContent = `${prefix}${formatValue(current)}${suffix}`;
            if (progress < 1) {
              rafId = requestAnimationFrame(step);
              activeRafs.add(rafId);
            }
          }

          rafId = requestAnimationFrame(step);
          activeRafs.add(rafId);
        });
      },
      { threshold: 0.15 }
    );

    activeObservers.add(observer);
    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:before-swap", cleanupCountUps);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCountUps, { once: true });
  } else {
    initCountUps();
  }
  document.addEventListener("astro:after-swap", initCountUps);
</script>
