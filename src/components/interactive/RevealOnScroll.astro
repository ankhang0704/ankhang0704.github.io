---
interface Props {
  class?: string;
  delay?: number;
  duration?: number;
  threshold?: number;
  as?: any;
  [key: string]: any;
}

const {
  class: className = "",
  delay = 0,
  duration = 700,
  threshold = 0.1,
  as: Tag = "div",
  ...rest
} = Astro.props;
---

<Tag
  class={`reveal-on-scroll ${className}`}
  data-reveal-delay={delay}
  data-reveal-threshold={threshold}
  style={`--reveal-delay: ${delay}ms; --reveal-duration: ${duration}ms;`}
  {...rest}
>
  <slot />
</Tag>

<style>
  .reveal-on-scroll {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    transition:
      opacity var(--reveal-duration, 700ms) cubic-bezier(0.16, 1, 0.3, 1),
      transform var(--reveal-duration, 700ms) cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal-on-scroll.is-revealing {
    will-change: transform, opacity;
  }

  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    will-change: auto;
  }

  .reveal-on-scroll.is-revealed-instant {
    opacity: 1;
    transform: none;
    transition: none !important;
    transition-delay: 0ms !important;
    will-change: auto;
  }

  @media (scripting: none) {
    .reveal-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const activeObservers = new Set<IntersectionObserver>();

  function cleanupRevealObservers() {
    activeObservers.forEach((observer) => observer.disconnect());
    activeObservers.clear();
  }

  function initRevealOnScroll() {
    cleanupRevealObservers();

    const elements = Array.from(
      document.querySelectorAll<HTMLElement>(
        ".reveal-on-scroll:not(.is-revealed):not(.is-revealed-instant)"
      )
    );
    if (!elements.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      elements.forEach((el) => el.classList.add("is-revealed-instant"));
      return;
    }

    // Batch all layout reads before any DOM mutations to avoid read/write thrashing
    const winH = window.innerHeight;
    const rects = elements.map((el) => el.getBoundingClientRect());

    const instantElements: HTMLElement[] = [];
    const thresholdGroups = new Map<number, HTMLElement[]>();

    elements.forEach((el, index) => {
      const rect = rects[index];
      // Reveal elements already within or above the viewport immediately without fade delay
      if (rect.top < winH && (rect.bottom > 0 || rect.height > 0)) {
        instantElements.push(el);
        return;
      }

      const parsed = parseFloat(el.dataset.revealThreshold || "0.1");
      const threshold = Number.isFinite(parsed)
        ? Math.min(1, Math.max(0, parsed))
        : 0.1;
      const group = thresholdGroups.get(threshold);
      if (group) {
        group.push(el);
      } else {
        thresholdGroups.set(threshold, [el]);
      }
    });

    instantElements.forEach((el) => {
      el.classList.add("is-revealed-instant");
    });

    thresholdGroups.forEach((group, threshold) => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const target = entry.target as HTMLElement;
            target.classList.add("is-revealing", "is-revealed");
            const clearWillChange = () => {
              target.classList.remove("is-revealing");
            };
            target.addEventListener("transitionend", clearWillChange, {
              once: true,
            });
            target.addEventListener("transitioncancel", clearWillChange, {
              once: true,
            });
            observer.unobserve(target);
          });
        },
        { threshold, rootMargin: "0px 0px -50px 0px" }
      );

      activeObservers.add(observer);
      group.forEach((el) => observer.observe(el));
    });
  }

  document.addEventListener("astro:before-swap", cleanupRevealObservers);
  // Run immediately / on DOMContentLoaded + after-swap so snapshots capture visible state
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRevealOnScroll, {
      once: true,
    });
  } else {
    initRevealOnScroll();
  }
  document.addEventListener("astro:after-swap", initRevealOnScroll);
</script>
