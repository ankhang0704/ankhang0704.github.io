---
interface Props {
  class?: string;
  spotlightColor?: string;
  size?: number;
  as?: any;
  [key: string]: any;
}

const {
  class: className = "",
  spotlightColor = "rgba(125, 125, 125, 0.12)",
  size = 450,
  as: Tag = "div",
  ...rest
} = Astro.props;
---

<Tag
  class={`spotlight-card relative overflow-hidden ${className}`}
  data-spotlight-color={spotlightColor}
  data-spotlight-size={size}
  {...rest}
>
  <div
    class="spotlight-card-overlay pointer-events-none absolute inset-0 z-10 opacity-0 transition-opacity duration-300"
    aria-hidden="true"
  ></div>
  <slot />
</Tag>

<script>
  const activeRafs = new Set<number>();
  let spotlightLayoutGen = 0;
  let invalidationBound = false;

  function ensureLayoutInvalidation() {
    if (invalidationBound) return;
    invalidationBound = true;
    const invalidate = () => {
      spotlightLayoutGen += 1;
    };
    window.addEventListener("scroll", invalidate, { passive: true });
    window.addEventListener("resize", invalidate, { passive: true });
  }

  function cleanupSpotlightCards() {
    activeRafs.forEach((id) => cancelAnimationFrame(id));
    activeRafs.clear();
  }

  function initSpotlightCards() {
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !window.matchMedia("(hover: hover) and (pointer: fine)").matches
    ) {
      return;
    }

    const cards = document.querySelectorAll<HTMLElement>(".spotlight-card");
    if (!cards.length) return;
    ensureLayoutInvalidation();

    cards.forEach((card) => {
      if (card.dataset.spotlightInitialized === "true") return;
      card.dataset.spotlightInitialized = "true";

      const overlay = card.querySelector<HTMLElement>(
        ":scope > .spotlight-card-overlay"
      );
      if (!overlay) return;

      const color = card.dataset.spotlightColor || "rgba(125, 125, 125, 0.12)";
      const size = parseInt(card.dataset.spotlightSize || "450", 10);

      let rect: DOMRect | null = null;
      let rectGen = -1;
      let rafId: number | null = null;
      let pointerX = 0;
      let pointerY = 0;

      const updateGlow = () => {
        if (rafId !== null) {
          activeRafs.delete(rafId);
          rafId = null;
        }
        overlay.style.background = `radial-gradient(${size}px circle at ${pointerX.toFixed(1)}px ${pointerY.toFixed(1)}px, ${color}, transparent 70%)`;
        if (overlay.style.opacity !== "1") {
          overlay.style.opacity = "1";
        }
      };

      card.addEventListener("mouseenter", () => {
        rect = card.getBoundingClientRect();
        rectGen = spotlightLayoutGen;
      });

      card.addEventListener("mousemove", (e) => {
        if (!rect || rectGen !== spotlightLayoutGen) {
          rect = card.getBoundingClientRect();
          rectGen = spotlightLayoutGen;
        }
        pointerX = e.clientX - rect.left;
        pointerY = e.clientY - rect.top;

        if (rafId === null) {
          rafId = requestAnimationFrame(updateGlow);
          activeRafs.add(rafId);
        }
      });

      card.addEventListener("mouseleave", () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          activeRafs.delete(rafId);
          rafId = null;
        }
        rect = null;
        overlay.style.opacity = "0";
      });
    });
  }

  document.addEventListener("astro:before-swap", cleanupSpotlightCards);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlightCards, {
      once: true,
    });
  } else {
    initSpotlightCards();
  }
  document.addEventListener("astro:after-swap", initSpotlightCards);
</script>
