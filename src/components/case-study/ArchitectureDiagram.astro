---
import {
  architecturesEn,
  architecturesVi,
  type ProjectArchitecture,
} from "../../data/architectures";

interface Props {
  slug: string;
  lang: "en" | "vi";
}

const { slug, lang } = Astro.props;
const isVi = lang === "vi";

const architecture: ProjectArchitecture | undefined = isVi
  ? architecturesVi[slug]
  : architecturesEn[slug];

if (!architecture) {
  // If no architecture diagram is configured for this project, do not render
  return;
}
---

<section
  id="system-architecture"
  aria-label={
    isVi ? "Sơ đồ kiến trúc hệ thống" : "System Architecture Blueprint"
  }
  class="mb-20 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark text-black dark:text-white"
>
  <!-- Architectural Blueprint Terminal Header -->
  <header class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-3.5 border-b border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark text-xs font-mono">
    <div class="flex items-center gap-2.5">
      <span
        class="w-2 h-2 bg-emerald-500 flex-shrink-0"
        aria-hidden="true"
      ></span>
      <span class="font-bold tracking-wider">{architecture.code}</span>
      <span class="opacity-40">/</span>
      <span class="uppercase tracking-widest opacity-80">
        {architecture.badge}
      </span>
    </div>

    <!-- View Mode Switcher -->
    {architecture.pipeline && (
      <div
        role="tablist"
        aria-label={isVi ? "Chế độ xem kiến trúc" : "Architecture View Mode"}
        class="flex items-center border border-black/20 dark:border-white/20 text-[11px] font-mono"
      >
        <button
          type="button"
          role="tab"
          id={`tab-topology-${slug}`}
          aria-selected="true"
          aria-controls={`panel-topology-${slug}`}
          data-view="topology"
          class="arch-tab-btn px-3 py-1 bg-black text-white dark:bg-white dark:text-black font-semibold transition-colors"
        >
          {isVi ? "Kiến Trúc Phân Tầng" : "Layered Topology"}
        </button>
        <button
          type="button"
          role="tab"
          id={`tab-pipeline-${slug}`}
          aria-selected="false"
          aria-controls={`panel-pipeline-${slug}`}
          data-view="pipeline"
          class="arch-tab-btn px-3 py-1 opacity-70 hover:opacity-100 transition-colors"
        >
          {isVi ? "Luồng Dữ Liệu & Quy Trình" : "Data Flow & Pipeline"}
        </button>
      </div>
    )}
  </header>

  <!-- Title & High-Level Architecture Narrative -->
  <div class="p-6 sm:p-8 border-b border-black/10 dark:border-white/10 space-y-4">
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-xs font-mono font-bold uppercase tracking-[0.2em] opacity-60">
        {isVi ? "Bản Vẽ Thiết Kế Hệ Thống" : "System Engineering Blueprint"}
      </span>
    </div>

    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">
      {architecture.title}
    </h2>

    <p class="font-sans text-sm sm:text-base font-light leading-relaxed opacity-85 max-w-3xl">
      {architecture.summary}
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 pt-3">
      {architecture.keyMetrics.map((metric) => (
        <div class="border border-black/10 dark:border-white/10 p-3 bg-bgLight dark:bg-bgDark">
          <div class="text-[10px] font-mono uppercase tracking-wider opacity-60">
            {metric.label}
          </div>
          <div class="font-mono text-xs sm:text-sm font-bold mt-1 text-black dark:text-white">
            {metric.value}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- PANEL 1: Layered Topology (Kiến Trúc Phân Tầng) -->
  <div
    id={`panel-topology-${slug}`}
    role="tabpanel"
    aria-labelledby={`tab-topology-${slug}`}
    class="arch-panel p-6 sm:p-8 space-y-6"
  >
    <div class="flex items-center justify-between text-xs font-mono opacity-60 pb-2">
      <span class="uppercase tracking-widest font-bold">
        {isVi
          ? "Các Tầng Hệ Thống & Ranh Giới Giao Tiếp"
          : "System Layers & Interface Boundaries"}
      </span>
      <span>
        {architecture.layers.length} {isVi ? "Tầng Phân Lập" : "Discrete Tiers"}
      </span>
    </div>

    <!-- Stack of Layers with Connectors -->
    <div class="space-y-4">
      {architecture.layers.map((layer, index) => (
        <div>
          <!-- Layer Card -->
          <article class="border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark p-5 sm:p-6 transition-colors hover:border-black/40 dark:hover:border-white/40 group">
            <!-- Layer Header -->
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                    {layer.tier}
                  </span>
                  <span class="text-xs font-mono uppercase tracking-wider opacity-60 font-semibold">
                    {layer.tag}
                  </span>
                </div>
                <h3 class="font-display text-lg sm:text-xl font-bold tracking-tight mt-1">
                  {layer.name}
                </h3>
              </div>

              <!-- Protocols Badges -->
              <div class="flex flex-wrap gap-1.5 self-start">
                {layer.protocols.map((proto) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark opacity-80">
                    {proto}
                  </span>
                ))}
              </div>
            </div>

            <!-- Content Grid: Responsibilities & Invariants -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-black/5 dark:border-white/5 text-xs font-mono">
              <!-- Responsibilities & Components -->
              <div class="space-y-3">
                <div>
                  <h4 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                    {isVi ? "Thành Phần Cốt Lõi:" : "Core Components:"}
                  </h4>
                  <ul class="space-y-1.5 font-sans text-xs opacity-90">
                    {layer.components.map((comp) => (
                      <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 bg-black dark:bg-white flex-shrink-0 mt-1.5"></span>
                        <span>{comp}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-2">
                  <h4 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                    {isVi
                      ? "Trách Nhiệm Kỹ Thuật:"
                      : "Technical Responsibilities:"}
                  </h4>
                  <ul class="space-y-1.5 font-sans text-xs opacity-90">
                    {layer.responsibilities.map((resp) => (
                      <li class="flex items-start gap-2">
                        <span class="opacity-40 select-none">→</span>
                        <span>{resp}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Invariants & Fault Tolerance -->
              <div class="space-y-3">
                <div>
                  <h4 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                    {isVi
                      ? "Tính Bất Biến & Ràng Buộc:"
                      : "Guarantees & Invariants:"}
                  </h4>
                  <ul class="space-y-1.5 font-sans text-xs opacity-90">
                    {layer.invariants.map((inv) => (
                      <li class="flex items-start gap-2">
                        <span class="text-emerald-500 font-bold select-none">
                          ✓
                        </span>
                        <span>{inv}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-2">
                  <h4 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                    {isVi
                      ? "Cơ Chế Chịu Lỗi & Dự Phòng:"
                      : "Fault Tolerance & Fallback:"}
                  </h4>
                  <div class="p-2.5 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark text-xs font-sans opacity-85 leading-relaxed">
                    {layer.errorHandling}
                  </div>
                </div>
              </div>
            </div>
          </article>

          <!-- Inter-Layer Protocol Connector Arrow -->
          {index < architecture.layers.length - 1 && (
            <div class="flex flex-col items-center py-2" aria-hidden="true">
              <div class="h-4 w-px bg-black/25 dark:bg-white/25"></div>
              <div class="px-3 py-1 border border-black/20 dark:border-white/20 bg-cardLight dark:bg-cardDark text-[10px] font-mono tracking-wider uppercase opacity-70">
                {isVi
                  ? "Ranh Giới Giao Thức & Luồng Xác Thực"
                  : "Protocol Boundary & Auth Flow"}
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="opacity-60 -mt-0.5"
              >
                <path d="M12 5v14M19 12l-7 7-7-7" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- PANEL 2: Pipeline / Data Flow (Luồng Dữ Liệu & Quy Trình) -->
  {architecture.pipeline && (
    <div
      id={`panel-pipeline-${slug}`}
      role="tabpanel"
      aria-labelledby={`tab-pipeline-${slug}`}
      class="arch-panel hidden p-6 sm:p-8 space-y-6"
    >
      <div class="space-y-1 pb-2 border-b border-black/10 dark:border-white/10">
        <h3 class="font-display text-lg sm:text-xl font-bold tracking-tight">
          {architecture.pipelineTitle ||
            (isVi ? "Quy Trình Xử Lý" : "Processing Pipeline")}
        </h3>
        <p class="font-sans text-xs sm:text-sm font-light opacity-80">
          {architecture.pipelineDescription}
        </p>
      </div>

      <!-- Pipeline Steps Timeline -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {architecture.pipeline.map((stage) => (
          <article class="border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark p-4 sm:p-5 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-mono font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                  {stage.step}
                </span>
                <span class="text-[10px] font-mono uppercase tracking-wider opacity-60 font-semibold">
                  {stage.tag}
                </span>
              </div>

              <h4 class="font-display text-base font-bold tracking-tight">
                {stage.name}
              </h4>

              <p class="font-sans text-xs font-light leading-relaxed opacity-85">
                {stage.description}
              </p>
            </div>

            <!-- Input / Output Specs -->
            <div class="pt-3 border-t border-black/10 dark:border-white/10 space-y-2 text-[11px] font-mono">
              <div class="flex items-start gap-1.5">
                <span class="opacity-50 select-none font-bold">IN:</span>
                <span class="opacity-80 break-words font-sans text-xs">
                  {stage.input}
                </span>
              </div>
              <div class="flex items-start gap-1.5">
                <span class="opacity-50 select-none font-bold">OUT:</span>
                <span class="opacity-80 break-words font-sans text-xs">
                  {stage.output}
                </span>
              </div>
              <div class="pt-1.5 text-[10px] border-t border-black/5 dark:border-white/5 text-emerald-600 dark:text-emerald-400 font-medium">
                ⚡ {stage.invariants}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
</section>

<script>
  function initArchitectureTabs() {
    const containers = document.querySelectorAll("#system-architecture");
    containers.forEach((container) => {
      const tabBtns = container.querySelectorAll(".arch-tab-btn");
      const panels = container.querySelectorAll(".arch-panel");

      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetView = btn.getAttribute("data-view");

          tabBtns.forEach((b) => {
            const isTarget = b.getAttribute("data-view") === targetView;
            b.setAttribute("aria-selected", isTarget ? "true" : "false");
            if (isTarget) {
              b.classList.add(
                "bg-black",
                "text-white",
                "dark:bg-white",
                "dark:text-black",
                "font-semibold"
              );
              b.classList.remove("opacity-70");
            } else {
              b.classList.remove(
                "bg-black",
                "text-white",
                "dark:bg-white",
                "dark:text-black",
                "font-semibold"
              );
              b.classList.add("opacity-70");
            }
          });

          panels.forEach((panel) => {
            const panelId = panel.getAttribute("id") || "";
            if (panelId.includes(targetView || "")) {
              panel.classList.remove("hidden");
            } else {
              panel.classList.add("hidden");
            }
          });
        });
      });
    });
  }

  // Bind to Astro lifecycle
  document.addEventListener("astro:page-load", initArchitectureTabs);
</script>
