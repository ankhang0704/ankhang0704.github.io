---
import {
  architecturesEn,
  architecturesVi,
  type ProjectArchitecture,
} from "../../data/architectures";

interface Props {
  slug: string;
  lang: "en" | "vi";
}

const { slug, lang } = Astro.props;
const isVi = lang === "vi";

const architecture: ProjectArchitecture | undefined = isVi
  ? architecturesVi[slug]
  : architecturesEn[slug];

if (!architecture) {
  return;
}
---

<section
  id="system-architecture"
  aria-label={isVi ? "Sơ đồ kiến trúc hệ thống" : "System Architecture Circuit"}
  class="mb-20 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark text-black dark:text-white"
>
  <!-- Architectural Header -->
  <header class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-6 py-3 border-b border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark text-xs font-mono">
    <div class="flex items-center gap-2">
      <span
        class="arch-live-dot w-2 h-2 bg-emerald-500 animate-pulse flex-shrink-0"
        aria-hidden="true"
      ></span>
      <span class="font-bold tracking-wider">{architecture.code}</span>
      <span class="opacity-40">/</span>
      <span class="uppercase tracking-widest opacity-75">
        {architecture.badge}
      </span>
    </div>

    <!-- Responsive View Mode Switcher (Never overflows on mobile) -->
    {architecture.pipeline && (
      <div
        role="tablist"
        aria-label={isVi ? "Chế độ xem sơ đồ" : "Diagram View Mode"}
        class="w-full sm:w-auto grid grid-cols-2 sm:flex items-center border border-black/20 dark:border-white/20 text-[11px] font-mono text-center"
      >
        <button
          type="button"
          role="tab"
          id={`tab-topology-${slug}`}
          aria-selected="true"
          aria-controls={`circuit-topology-${slug}`}
          data-view="topology"
          class="arch-mode-btn px-3 py-1 bg-black text-white dark:bg-white dark:text-black font-semibold transition-colors"
        >
          {isVi ? "Phân Tầng" : "Topology"}
        </button>
        <button
          type="button"
          role="tab"
          id={`tab-pipeline-${slug}`}
          aria-selected="false"
          aria-controls={`circuit-pipeline-${slug}`}
          data-view="pipeline"
          class="arch-mode-btn px-3 py-1 opacity-70 hover:opacity-100 transition-colors"
        >
          {isVi ? "Quy Trình" : "Pipeline"}
        </button>
      </div>
    )}
  </header>

  <!-- Confident Title (Zero Subtitle Bloat) -->
  <div class="px-4 sm:px-6 py-4 sm:py-5 border-b border-black/10 dark:border-white/10">
    <h2 class="font-display text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight">
      {architecture.title}
    </h2>
  </div>

  <!-- MODE 1: LAYERED CIRCUIT VIEW (Kiến Trúc Phân Tầng) -->
  <div
    id={`circuit-topology-${slug}`}
    class="arch-view-panel p-3.5 sm:p-5 lg:p-6 space-y-4 sm:space-y-5"
    data-panel="topology"
  >
    <!-- Circuit Track (Zero-Overflow Bounded Equation) -->
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-1.5 sm:gap-2">
      {architecture.layers.map((layer, idx) => (
        <>
          <!-- Node Button Card (Compact & Editorial) -->
          <button
            type="button"
            data-layer-index={idx}
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`layer-inspector-${slug}-${idx}`}
            class={`layer-node-btn flex-1 min-w-0 text-left p-3 sm:p-4 border transition-[border-color,background-color,box-shadow,transform] duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white group ${
              idx === 0
                ? "active-node border-black dark:border-white bg-black/5 dark:bg-white/5 ring-1 ring-black dark:ring-white"
                : "border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark hover:border-black/40 dark:hover:border-white/40"
            }`}
          >
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                {layer.tier}
              </span>
              <span class="w-1.5 h-1.5 node-indicator-dot bg-emerald-500 rounded-none"></span>
            </div>

            <h3 class="font-display text-xs sm:text-sm font-bold tracking-tight truncate group-hover:opacity-80 transition-opacity">
              {layer.name}
            </h3>
          </button>

          <!-- Desktop Animated Signal Conduit (Pure SVG Wire, No Text Blowout) -->
          {idx < architecture.layers.length - 1 && (
            <div
              class="hidden lg:flex items-center justify-center w-6 lg:w-8 flex-shrink-0"
              aria-hidden="true"
            >
              <svg
                width="28"
                height="12"
                viewBox="0 0 28 12"
                fill="none"
                class="overflow-visible text-black/50 dark:text-white/50"
              >
                <line
                  x1="0"
                  y1="6"
                  x2="20"
                  y2="6"
                  stroke="currentColor"
                  stroke-width="2"
                  class="circuit-wire-h"
                />
                <polygon points="20,2 28,6 20,10" fill="currentColor" />
              </svg>
            </div>
          )}

          <!-- Mobile Animated Signal Conduit (Vertical) -->
          {idx < architecture.layers.length - 1 && (
            <div
              class="lg:hidden flex items-center justify-center py-1 flex-shrink-0"
              aria-hidden="true"
            >
              <svg
                width="12"
                height="18"
                viewBox="0 0 12 18"
                fill="none"
                class="overflow-visible text-black/50 dark:text-white/50"
              >
                <line
                  x1="6"
                  y1="0"
                  x2="6"
                  y2="12"
                  stroke="currentColor"
                  stroke-width="2"
                  class="circuit-wire-v"
                />
                <polygon points="2,12 6,18 10,12" fill="currentColor" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>

    <!-- SINGLE DEDICATED INSPECTOR PANEL (Switches on Node Click) -->
    <div
      id={`topology-inspector-container-${slug}`}
      class="border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark"
    >
      {architecture.layers.map((layer, idx) => (
        <article
          id={`layer-inspector-${slug}-${idx}`}
          class={`layer-inspector-card p-4 sm:p-6 lg:p-7 space-y-4 sm:space-y-5 ${idx === 0 ? "block" : "hidden"}`}
        >
          <!-- Inspector Header -->
          <div class="flex flex-wrap items-center justify-between gap-2.5 pb-3.5 border-b border-black/10 dark:border-white/10">
            <h4 class="font-display text-base sm:text-lg font-bold tracking-tight">
              <span class="font-mono text-xs font-bold px-2 py-0.5 mr-2 bg-black text-white dark:bg-white dark:text-black">
                {layer.tier}
              </span>
              <span>{layer.name}</span>
            </h4>

            <div class="flex flex-wrap gap-1.5 self-start">
              {layer.protocols.map((proto) => (
                <span class="text-[10px] font-mono px-2 py-0.5 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark opacity-85">
                  {proto}
                </span>
              ))}
            </div>
          </div>

          <!-- Inspector Body Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs font-mono">
            <!-- Left: Responsibilities & Modules -->
            <div class="space-y-4">
              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi ? "Trách Nhiệm Kỹ Thuật" : "Responsibilities"}
                </h5>
                <ul class="space-y-1.5 font-sans text-xs opacity-90">
                  {layer.responsibilities.map((resp) => (
                    <li class="flex items-start gap-2">
                      <span class="opacity-40 select-none font-mono">→</span>
                      <span>{resp}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi ? "Thành Phần Cốt Lõi" : "Components"}
                </h5>
                <div class="flex flex-wrap gap-1.5">
                  {layer.components.map((comp) => (
                    <span class="px-2 py-0.5 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark text-[11px] font-sans">
                      {comp}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right: Invariants & Fault Tolerance -->
            <div class="space-y-4">
              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi
                    ? "Tính Bất Biến & Ràng Buộc"
                    : "Guarantees & Invariants"}
                </h5>
                <ul class="space-y-1.5 font-sans text-xs opacity-90">
                  {layer.invariants.map((inv) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-500 font-bold select-none font-mono">
                        ✓
                      </span>
                      <span>{inv}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi ? "Cơ Chế Chịu Lỗi & Dự Phòng" : "Fault Tolerance"}
                </h5>
                <div class="p-2.5 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark text-xs font-sans opacity-90 leading-relaxed">
                  {layer.errorHandling}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- MODE 2: PIPELINE CIRCUIT VIEW (Luồng Dữ Liệu & Quy Trình) -->
  {architecture.pipeline && (
    <div
      id={`circuit-pipeline-${slug}`}
      class="arch-view-panel hidden p-3.5 sm:p-5 lg:p-6 space-y-4 sm:space-y-5"
      data-panel="pipeline"
    >
      <!-- Pipeline Steps Grid (Responsive 1/2/3 Columns) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-2.5">
        {architecture.pipeline.map((stage, idx) => (
          <button
            type="button"
            data-stage-index={idx}
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`stage-inspector-${slug}-${idx}`}
            class={`stage-node-btn min-w-0 text-left p-3 border transition-[border-color,background-color,box-shadow,transform] duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white group ${
              idx === 0
                ? "active-node border-black dark:border-white bg-black/5 dark:bg-white/5 ring-1 ring-black dark:ring-white"
                : "border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark hover:border-black/40 dark:hover:border-white/40"
            }`}
          >
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                {stage.step}
              </span>
              <span class="w-1.5 h-1.5 rounded-none bg-emerald-500"></span>
            </div>

            <h4 class="font-display text-xs sm:text-sm font-bold tracking-tight truncate group-hover:opacity-80 transition-opacity">
              {stage.name}
            </h4>
          </button>
        ))}
      </div>

      <!-- Pipeline Inspector Panel -->
      <div
        id={`pipeline-inspector-container-${slug}`}
        class="border border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark"
      >
        {architecture.pipeline.map((stage, idx) => (
          <article
            id={`stage-inspector-${slug}-${idx}`}
            class={`stage-inspector-card p-4 sm:p-6 lg:p-7 space-y-4 ${idx === 0 ? "block" : "hidden"}`}
          >
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-black/10 dark:border-white/10">
              <h4 class="font-display text-base sm:text-lg font-bold tracking-tight">
                <span class="font-mono text-xs font-bold px-2 py-0.5 mr-2 bg-black text-white dark:bg-white dark:text-black">
                  {stage.step}
                </span>
                <span>{stage.name}</span>
              </h4>

              <div class="text-[10px] font-mono text-emerald-700 dark:text-emerald-400 font-medium">
                ⚡ {stage.invariants}
              </div>
            </div>

            <p class="font-sans text-xs sm:text-sm font-light opacity-85 leading-relaxed">
              {stage.description}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-black/10 dark:border-white/10 text-xs font-mono">
              <div class="p-2.5 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark">
                <span class="text-[10px] uppercase tracking-wider opacity-60 font-bold block mb-1">
                  {isVi ? "Đầu Vào (IN)" : "Input (IN)"}
                </span>
                <span class="font-sans text-xs opacity-90 break-words">
                  {stage.input}
                </span>
              </div>
              <div class="p-2.5 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark">
                <span class="text-[10px] uppercase tracking-wider opacity-60 font-bold block mb-1">
                  {isVi ? "Đầu Ra (OUT)" : "Output (OUT)"}
                </span>
                <span class="font-sans text-xs opacity-90 break-words">
                  {stage.output}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  /* Keyframe pure CSS animated circuit lines (Hardware accelerated, < 1KB) */
  @keyframes circuitFlowH {
    0% {
      stroke-dashoffset: 20;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes circuitFlowV {
    0% {
      stroke-dashoffset: 20;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  .circuit-wire-h {
    stroke-dasharray: 5 3;
    animation: circuitFlowH 1.2s linear infinite;
  }

  .circuit-wire-v {
    stroke-dasharray: 5 3;
    animation: circuitFlowV 1.2s linear infinite;
  }

  /* Micro-Interactions & Inspector Transitions */
  .active-node .node-indicator-dot {
    animation: activePulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes activePulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.85);
    }
  }

  .layer-inspector-card.block,
  .stage-inspector-card.block {
    animation: inspectorFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes inspectorFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .layer-node-btn:active,
  .stage-node-btn:active {
    transform: scale(0.99);
  }

  #system-architecture.arch-paused .circuit-wire-h,
  #system-architecture.arch-paused .circuit-wire-v,
  #system-architecture.arch-paused .active-node .node-indicator-dot,
  #system-architecture.arch-paused .arch-live-dot {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-live-dot,
    .circuit-wire-h,
    .circuit-wire-v,
    .active-node .node-indicator-dot,
    .layer-inspector-card.block,
    .stage-inspector-card.block {
      animation: none !important;
      stroke-dasharray: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  const activeObservers = new Set<IntersectionObserver>();

  function cleanupArchitectureDiagrams() {
    activeObservers.forEach((observer) => observer.disconnect());
    activeObservers.clear();
  }

  function selectDiagramNode(
    buttons: NodeListOf<Element>,
    cards: NodeListOf<Element>,
    indexAttr: string,
    targetIdx: string | null
  ) {
    buttons.forEach((b) => {
      const isTarget = b.getAttribute(indexAttr) === targetIdx;
      if (isTarget) {
        b.classList.add(
          "active-node",
          "border-black",
          "dark:border-white",
          "bg-black/5",
          "dark:bg-white/5",
          "ring-1",
          "ring-black",
          "dark:ring-white"
        );
        b.classList.remove(
          "border-black/15",
          "dark:border-white/15",
          "bg-bgLight",
          "dark:bg-bgDark"
        );
        b.setAttribute("aria-expanded", "true");
      } else {
        b.classList.remove(
          "active-node",
          "border-black",
          "dark:border-white",
          "bg-black/5",
          "dark:bg-white/5",
          "ring-1",
          "ring-black",
          "dark:ring-white"
        );
        b.classList.add(
          "border-black/15",
          "dark:border-white/15",
          "bg-bgLight",
          "dark:bg-bgDark"
        );
        b.setAttribute("aria-expanded", "false");
      }
    });

    cards.forEach((card, idx) => {
      if (idx.toString() === targetIdx) {
        card.classList.remove("hidden");
        card.classList.add("block");
      } else {
        card.classList.add("hidden");
        card.classList.remove("block");
      }
    });
  }

  function setupCircuitInteractions() {
    cleanupArchitectureDiagrams();

    const sections = document.querySelectorAll<HTMLElement>(
      "#system-architecture"
    );
    if (!sections.length) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let visibilityObserver: IntersectionObserver | null = null;
    if (!prefersReducedMotion) {
      visibilityObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          (entry.target as HTMLElement).classList.toggle(
            "arch-paused",
            !entry.isIntersecting
          );
        });
      });
      activeObservers.add(visibilityObserver);
    }

    sections.forEach((section) => {
      visibilityObserver?.observe(section);

      if (section.dataset.archInitialized === "true") return;
      section.dataset.archInitialized = "true";

      const modeBtns = section.querySelectorAll(".arch-mode-btn");
      const viewPanels = section.querySelectorAll(".arch-view-panel");
      const layerBtns = section.querySelectorAll(".layer-node-btn");
      const layerCards = section.querySelectorAll(".layer-inspector-card");
      const stageBtns = section.querySelectorAll(".stage-node-btn");
      const stageCards = section.querySelectorAll(".stage-inspector-card");

      section.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const modeBtn = target.closest<HTMLElement>(".arch-mode-btn");
        if (modeBtn && section.contains(modeBtn)) {
          const targetView = modeBtn.getAttribute("data-view");
          modeBtns.forEach((b) => {
            const isTarget = b.getAttribute("data-view") === targetView;
            b.setAttribute("aria-selected", isTarget ? "true" : "false");
            if (isTarget) {
              b.classList.add(
                "bg-black",
                "text-white",
                "dark:bg-white",
                "dark:text-black",
                "font-semibold"
              );
              b.classList.remove("opacity-70");
            } else {
              b.classList.remove(
                "bg-black",
                "text-white",
                "dark:bg-white",
                "dark:text-black",
                "font-semibold"
              );
              b.classList.add("opacity-70");
            }
          });

          viewPanels.forEach((panel) => {
            if (panel.getAttribute("data-panel") === targetView) {
              panel.classList.remove("hidden");
            } else {
              panel.classList.add("hidden");
            }
          });
          return;
        }

        const layerBtn = target.closest<HTMLElement>(".layer-node-btn");
        if (layerBtn && section.contains(layerBtn)) {
          selectDiagramNode(
            layerBtns,
            layerCards,
            "data-layer-index",
            layerBtn.getAttribute("data-layer-index")
          );
          return;
        }

        const stageBtn = target.closest<HTMLElement>(".stage-node-btn");
        if (stageBtn && section.contains(stageBtn)) {
          selectDiagramNode(
            stageBtns,
            stageCards,
            "data-stage-index",
            stageBtn.getAttribute("data-stage-index")
          );
        }
      });
    });
  }

  document.addEventListener("astro:before-swap", cleanupArchitectureDiagrams);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCircuitInteractions, {
      once: true,
    });
  } else {
    setupCircuitInteractions();
  }
  document.addEventListener("astro:after-swap", setupCircuitInteractions);
</script>
