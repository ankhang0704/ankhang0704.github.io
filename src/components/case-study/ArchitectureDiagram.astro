---
import {
  architecturesEn,
  architecturesVi,
  type ProjectArchitecture,
} from "../../data/architectures";

interface Props {
  slug: string;
  lang: "en" | "vi";
}

const { slug, lang } = Astro.props;
const isVi = lang === "vi";

const architecture: ProjectArchitecture | undefined = isVi
  ? architecturesVi[slug]
  : architecturesEn[slug];

if (!architecture) {
  return;
}
---

<section
  id="system-architecture"
  aria-label={
    isVi ? "Sơ đồ mạch kiến trúc hệ thống" : "System Architecture Circuit"
  }
  class="mb-20 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark text-black dark:text-white"
>
  <!-- Architectural Circuit Header -->
  <header class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-6 py-3.5 border-b border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark text-xs font-mono">
    <div class="flex items-center gap-2.5">
      <span
        class="w-2 h-2 bg-emerald-500 animate-pulse flex-shrink-0"
        aria-hidden="true"
      ></span>
      <span class="font-bold tracking-wider">{architecture.code}</span>
      <span class="opacity-40">/</span>
      <span class="uppercase tracking-widest opacity-80">
        {architecture.badge}
      </span>
    </div>

    <!-- View Mode Switcher (if pipeline exists) -->
    {architecture.pipeline && (
      <div
        role="tablist"
        aria-label={isVi ? "Chế độ xem sơ đồ" : "Diagram View Mode"}
        class="flex items-center border border-black/20 dark:border-white/20 text-[11px] font-mono"
      >
        <button
          type="button"
          role="tab"
          id={`tab-topology-${slug}`}
          aria-selected="true"
          aria-controls={`circuit-topology-${slug}`}
          data-view="topology"
          class="arch-mode-btn px-3 py-1 bg-black text-white dark:bg-white dark:text-black font-semibold transition-colors"
        >
          {isVi ? "Kiến Trúc Phân Tầng" : "Layered Topology"}
        </button>
        <button
          type="button"
          role="tab"
          id={`tab-pipeline-${slug}`}
          aria-selected="false"
          aria-controls={`circuit-pipeline-${slug}`}
          data-view="pipeline"
          class="arch-mode-btn px-3 py-1 opacity-70 hover:opacity-100 transition-colors"
        >
          {isVi ? "Luồng Dữ Liệu & Quy Trình" : "Data Flow & Pipeline"}
        </button>
      </div>
    )}
  </header>

  <!-- Title & Clean Circuit Narrative -->
  <div class="p-6 sm:p-8 border-b border-black/10 dark:border-white/10 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs font-mono font-bold uppercase tracking-[0.2em] opacity-60">
        {isVi ? "SƠ ĐỒ MẠCH HỆ THỐNG" : "SYSTEM CIRCUIT TOPOLOGY"}
      </span>
      <span class="text-[11px] font-mono opacity-60 text-emerald-600 dark:text-emerald-400">
        ●{" "}
        {isVi
          ? "Nhấp vào từng khối để xem chi tiết kỹ thuật ▾"
          : "Click any node to inspect specifications ▾"}
      </span>
    </div>

    <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight">
      {architecture.title}
    </h2>

    <p class="font-sans text-xs sm:text-sm font-light leading-relaxed opacity-85 max-w-3xl">
      {architecture.summary}
    </p>

    <!-- Key Metrics Ribbon -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 pt-2">
      {architecture.keyMetrics.map((metric) => (
        <div class="border border-black/10 dark:border-white/10 p-2.5 bg-bgLight dark:bg-bgDark">
          <div class="text-[9px] font-mono uppercase tracking-wider opacity-60">
            {metric.label}
          </div>
          <div class="font-mono text-xs sm:text-sm font-bold mt-0.5 text-black dark:text-white">
            {metric.value}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- MODE 1: LAYERED CIRCUIT VIEW (Kiến Trúc Phân Tầng) -->
  <div
    id={`circuit-topology-${slug}`}
    class="arch-view-panel p-6 sm:p-8 space-y-6"
    data-panel="topology"
  >
    <!-- Circuit Nodes & Connectors (Clean Minimal Flow) -->
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-2 sm:gap-3">
      {architecture.layers.map((layer, idx) => (
        <>
          <!-- Node Button Card -->
          <button
            type="button"
            data-layer-index={idx}
            data-group="topology"
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`layer-inspector-${slug}-${idx}`}
            class={`layer-node-btn flex-1 text-left p-4 sm:p-5 border transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white group ${
              idx === 0
                ? "active-node border-black dark:border-white bg-black/5 dark:bg-white/5 ring-1 ring-black dark:ring-white"
                : "border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark hover:border-black/50 dark:hover:border-white/50"
            }`}
          >
            <!-- Node Header -->
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="node-tier-badge text-[10px] font-mono font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                {layer.tier}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider opacity-60 font-semibold truncate">
                {layer.tag}
              </span>
            </div>

            <!-- Node Title -->
            <h3 class="font-display text-sm sm:text-base font-bold tracking-tight group-hover:opacity-80 transition-opacity">
              {layer.name}
            </h3>

            <!-- Tech Summary Chip -->
            <p class="text-xs font-mono opacity-70 mt-1 truncate">
              {layer.techSummary || layer.components[0]}
            </p>

            <!-- Bottom Inspect Indicator -->
            <div class="mt-4 pt-2 border-t border-black/10 dark:border-white/10 flex items-center justify-between text-[10px] font-mono">
              <span class="node-state-text opacity-70 group-hover:opacity-100 font-semibold">
                {idx === 0
                  ? isVi
                    ? "Đang xem chi tiết ▴"
                    : "Viewing specs ▴"
                  : isVi
                    ? "Xem chi tiết ▾"
                    : "Inspect node ▾"}
              </span>
              <span class="w-1.5 h-1.5 node-indicator-dot rounded-none bg-emerald-500"></span>
            </div>
          </button>

          <!-- Desktop Animated Horizontal Connector -->
          {idx < architecture.layers.length - 1 && (
            <div
              class="hidden lg:flex flex-col items-center justify-center px-1 flex-shrink-0"
              aria-hidden="true"
            >
              <div class="text-[9px] font-mono uppercase tracking-wider opacity-60 mb-1 px-1.5 py-0.5 border border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark whitespace-nowrap">
                {layer.connectorLabel || "FLOW"}
              </div>
              <svg
                width="44"
                height="16"
                viewBox="0 0 44 16"
                fill="none"
                class="overflow-visible text-black/50 dark:text-white/50"
              >
                <line
                  x1="0"
                  y1="8"
                  x2="36"
                  y2="8"
                  stroke="currentColor"
                  stroke-width="2"
                  class="circuit-wire-h"
                />
                <polygon points="36,4 44,8 36,12" fill="currentColor" />
              </svg>
            </div>
          )}

          <!-- Mobile Animated Vertical Connector -->
          {idx < architecture.layers.length - 1 && (
            <div
              class="lg:hidden flex flex-col items-center justify-center py-2"
              aria-hidden="true"
            >
              <div class="text-[9px] font-mono uppercase tracking-wider opacity-60 mb-1 px-2 py-0.5 border border-black/10 dark:border-white/10 bg-bgLight dark:bg-bgDark">
                {layer.connectorLabel || "FLOW"}
              </div>
              <svg
                width="16"
                height="28"
                viewBox="0 0 16 28"
                fill="none"
                class="overflow-visible text-black/50 dark:text-white/50"
              >
                <line
                  x1="8"
                  y1="0"
                  x2="8"
                  y2="20"
                  stroke="currentColor"
                  stroke-width="2"
                  class="circuit-wire-v"
                />
                <polygon points="4,20 8,28 12,20" fill="currentColor" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>

    <!-- SINGLE DEDICATED INSPECTOR PANEL (Switches cleanly when a node is clicked) -->
    <div
      id={`topology-inspector-container-${slug}`}
      class="border border-black/20 dark:border-white/20 bg-bgLight dark:bg-bgDark transition-all duration-300"
    >
      {architecture.layers.map((layer, idx) => (
        <article
          id={`layer-inspector-${slug}-${idx}`}
          class={`layer-inspector-card p-6 sm:p-7 space-y-5 ${idx === 0 ? "block" : "hidden"}`}
        >
          <!-- Inspector Header -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-black/10 dark:border-white/10">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold px-2.5 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                  {layer.tier}
                </span>
                <span class="text-xs font-mono uppercase tracking-widest opacity-60 font-semibold">
                  {layer.tag}
                </span>
              </div>
              <h4 class="font-display text-xl sm:text-2xl font-bold tracking-tight mt-1">
                {layer.name}
              </h4>
            </div>

            <!-- Protocol Badges -->
            <div class="flex flex-wrap gap-1.5 self-start">
              {layer.protocols.map((proto) => (
                <span class="text-[10px] font-mono px-2 py-0.5 border border-black/15 dark:border-white/15 bg-cardLight dark:bg-cardDark opacity-85">
                  {proto}
                </span>
              ))}
            </div>
          </div>

          <!-- Inspector Body Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs font-mono">
            <!-- Left: Responsibilities & Modules -->
            <div class="space-y-4">
              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi
                    ? "Trách Nhiệm Kỹ Thuật:"
                    : "Technical Responsibilities:"}
                </h5>
                <ul class="space-y-2 font-sans text-xs opacity-90">
                  {layer.responsibilities.map((resp) => (
                    <li class="flex items-start gap-2">
                      <span class="opacity-40 select-none font-mono">→</span>
                      <span>{resp}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi ? "Thành Phần Cốt Lõi:" : "Core Components:"}
                </h5>
                <div class="flex flex-wrap gap-1.5">
                  {layer.components.map((comp) => (
                    <span class="px-2 py-1 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark text-[11px] font-sans">
                      {comp}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right: Invariants & Fault Tolerance -->
            <div class="space-y-4">
              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi
                    ? "Tính Bất Biến & Ràng Buộc:"
                    : "Guarantees & Invariants:"}
                </h5>
                <ul class="space-y-2 font-sans text-xs opacity-90">
                  {layer.invariants.map((inv) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-500 font-bold select-none font-mono">
                        ✓
                      </span>
                      <span>{inv}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h5 class="font-bold uppercase tracking-wider opacity-60 mb-2">
                  {isVi
                    ? "Cơ Chế Chịu Lỗi & Dự Phòng:"
                    : "Fault Tolerance & Fallback:"}
                </h5>
                <div class="p-3 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark text-xs font-sans opacity-90 leading-relaxed">
                  {layer.errorHandling}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- MODE 2: PIPELINE CIRCUIT VIEW (Luồng Dữ Liệu & Quy Trình) -->
  {architecture.pipeline && (
    <div
      id={`circuit-pipeline-${slug}`}
      class="arch-view-panel hidden p-6 sm:p-8 space-y-6"
      data-panel="pipeline"
    >
      <div class="space-y-1 pb-2 border-b border-black/10 dark:border-white/10">
        <h3 class="font-display text-lg sm:text-xl font-bold tracking-tight">
          {architecture.pipelineTitle ||
            (isVi ? "Quy Trình Xử Lý Tuần Tự" : "Serialized Pipeline")}
        </h3>
        <p class="font-sans text-xs sm:text-sm font-light opacity-80">
          {architecture.pipelineDescription}
        </p>
      </div>

      <!-- Pipeline Circuit Nodes (Clean Sequence) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {architecture.pipeline.map((stage, idx) => (
          <button
            type="button"
            data-stage-index={idx}
            data-group="pipeline"
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`stage-inspector-${slug}-${idx}`}
            class={`stage-node-btn text-left p-4 border transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white group ${
              idx === 0
                ? "active-node border-black dark:border-white bg-black/5 dark:bg-white/5 ring-1 ring-black dark:ring-white"
                : "border-black/15 dark:border-white/15 bg-bgLight dark:bg-bgDark hover:border-black/50 dark:hover:border-white/50"
            }`}
          >
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                {stage.step}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider opacity-60 font-semibold truncate">
                {stage.tag}
              </span>
            </div>

            <h4 class="font-display text-sm font-bold tracking-tight group-hover:opacity-80 transition-opacity">
              {stage.name}
            </h4>

            <div class="mt-3 pt-2 border-t border-black/10 dark:border-white/10 flex items-center justify-between text-[10px] font-mono">
              <span class="stage-state-text opacity-70 group-hover:opacity-100 font-semibold">
                {idx === 0
                  ? isVi
                    ? "Đang xem chi tiết ▴"
                    : "Viewing specs ▴"
                  : isVi
                    ? "Xem chi tiết ▾"
                    : "Inspect stage ▾"}
              </span>
              <span class="w-1.5 h-1.5 rounded-none bg-emerald-500"></span>
            </div>
          </button>
        ))}
      </div>

      <!-- Pipeline Inspector Panel -->
      <div
        id={`pipeline-inspector-container-${slug}`}
        class="border border-black/20 dark:border-white/20 bg-bgLight dark:bg-bgDark transition-all duration-300"
      >
        {architecture.pipeline.map((stage, idx) => (
          <article
            id={`stage-inspector-${slug}-${idx}`}
            class={`stage-inspector-card p-6 sm:p-7 space-y-4 ${idx === 0 ? "block" : "hidden"}`}
          >
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-black/10 dark:border-white/10">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold px-2.5 py-0.5 bg-black text-white dark:bg-white dark:text-black">
                  {stage.step}
                </span>
                <span class="text-xs font-mono uppercase tracking-widest opacity-60 font-semibold">
                  {stage.tag}
                </span>
              </div>
              <div class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">
                ⚡ {stage.invariants}
              </div>
            </div>

            <h4 class="font-display text-xl font-bold tracking-tight">
              {stage.name}
            </h4>

            <p class="font-sans text-xs sm:text-sm font-light opacity-85 leading-relaxed">
              {stage.description}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-black/10 dark:border-white/10 text-xs font-mono">
              <div class="p-3 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark">
                <span class="text-[10px] uppercase tracking-wider opacity-60 font-bold block mb-1">
                  {isVi ? "Dữ Liệu Đầu Vào (IN):" : "Input Specification (IN):"}
                </span>
                <span class="font-sans text-xs opacity-90">{stage.input}</span>
              </div>
              <div class="p-3 border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark">
                <span class="text-[10px] uppercase tracking-wider opacity-60 font-bold block mb-1">
                  {isVi
                    ? "Dữ Liệu Đầu Ra (OUT):"
                    : "Output Specification (OUT):"}
                </span>
                <span class="font-sans text-xs opacity-90">{stage.output}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  /* Keyframe pure CSS animated circuit lines (Hardware accelerated, < 1KB) */
  @keyframes circuitFlowH {
    0% {
      stroke-dashoffset: 24;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes circuitFlowV {
    0% {
      stroke-dashoffset: 24;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  .circuit-wire-h {
    stroke-dasharray: 6 4;
    animation: circuitFlowH 1.4s linear infinite;
  }

  .circuit-wire-v {
    stroke-dasharray: 6 4;
    animation: circuitFlowV 1.4s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-wire-h,
    .circuit-wire-v {
      animation: none !important;
      stroke-dasharray: none !important;
    }
  }
</style>

<script>
  function setupCircuitInteractions() {
    const sections = document.querySelectorAll("#system-architecture");
    sections.forEach((section) => {
      // 1. Mode Tab Switching (Topology vs Pipeline)
      const modeBtns = section.querySelectorAll(".arch-mode-btn");
      const viewPanels = section.querySelectorAll(".arch-view-panel");

      modeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetView = btn.getAttribute("data-view");

          modeBtns.forEach((b) => {
            const isTarget = b.getAttribute("data-view") === targetView;
            b.setAttribute("aria-selected", isTarget ? "true" : "false");
            if (isTarget) {
              b.classList.add(
                "bg-black",
                "text-white",
                "dark:bg-white",
                "dark:text-black",
                "font-semibold"
              );
              b.classList.remove("opacity-70");
            } else {
              b.classList.remove(
                "bg-black",
                "text-white",
                "dark:bg-white",
                "dark:text-black",
                "font-semibold"
              );
              b.classList.add("opacity-70");
            }
          });

          viewPanels.forEach((panel) => {
            const panelType = panel.getAttribute("data-panel");
            if (panelType === targetView) {
              panel.classList.remove("hidden");
            } else {
              panel.classList.add("hidden");
            }
          });
        });
      });

      // 2. Topology Node Inspection Interaction
      const layerBtns = section.querySelectorAll(".layer-node-btn");
      const layerCards = section.querySelectorAll(".layer-inspector-card");

      layerBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetIdx = btn.getAttribute("data-layer-index");

          // Update Button states
          layerBtns.forEach((b) => {
            const bIdx = b.getAttribute("data-layer-index");
            const isTarget = bIdx === targetIdx;
            const stateText = b.querySelector(".node-state-text");

            if (isTarget) {
              b.classList.add(
                "active-node",
                "border-black",
                "dark:border-white",
                "bg-black/5",
                "dark:bg-white/5",
                "ring-1",
                "ring-black",
                "dark:ring-white"
              );
              b.classList.remove(
                "border-black/15",
                "dark:border-white/15",
                "bg-bgLight",
                "dark:bg-bgDark"
              );
              b.setAttribute("aria-expanded", "true");
              if (stateText)
                stateText.textContent = stateText.textContent?.includes(
                  "chi tiết"
                )
                  ? "Đang xem chi tiết ▴"
                  : "Viewing specs ▴";
            } else {
              b.classList.remove(
                "active-node",
                "border-black",
                "dark:border-white",
                "bg-black/5",
                "dark:bg-white/5",
                "ring-1",
                "ring-black",
                "dark:ring-white"
              );
              b.classList.add(
                "border-black/15",
                "dark:border-white/15",
                "bg-bgLight",
                "dark:bg-bgDark"
              );
              b.setAttribute("aria-expanded", "false");
              if (stateText)
                stateText.textContent = stateText.textContent?.includes(
                  "chi tiết"
                )
                  ? "Xem chi tiết ▾"
                  : "Inspect node ▾";
            }
          });

          // Update Inspector Card visibility
          layerCards.forEach((card, idx) => {
            if (idx.toString() === targetIdx) {
              card.classList.remove("hidden");
              card.classList.add("block");
            } else {
              card.classList.add("hidden");
              card.classList.remove("block");
            }
          });
        });
      });

      // 3. Pipeline Stage Inspection Interaction
      const stageBtns = section.querySelectorAll(".stage-node-btn");
      const stageCards = section.querySelectorAll(".stage-inspector-card");

      stageBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetIdx = btn.getAttribute("data-stage-index");

          stageBtns.forEach((b) => {
            const bIdx = b.getAttribute("data-stage-index");
            const isTarget = bIdx === targetIdx;
            const stateText = b.querySelector(".stage-state-text");

            if (isTarget) {
              b.classList.add(
                "active-node",
                "border-black",
                "dark:border-white",
                "bg-black/5",
                "dark:bg-white/5",
                "ring-1",
                "ring-black",
                "dark:ring-white"
              );
              b.classList.remove(
                "border-black/15",
                "dark:border-white/15",
                "bg-bgLight",
                "dark:bg-bgDark"
              );
              b.setAttribute("aria-expanded", "true");
              if (stateText)
                stateText.textContent = stateText.textContent?.includes(
                  "chi tiết"
                )
                  ? "Đang xem chi tiết ▴"
                  : "Viewing specs ▴";
            } else {
              b.classList.remove(
                "active-node",
                "border-black",
                "dark:border-white",
                "bg-black/5",
                "dark:bg-white/5",
                "ring-1",
                "ring-black",
                "dark:ring-white"
              );
              b.classList.add(
                "border-black/15",
                "dark:border-white/15",
                "bg-bgLight",
                "dark:bg-bgDark"
              );
              b.setAttribute("aria-expanded", "false");
              if (stateText)
                stateText.textContent = stateText.textContent?.includes(
                  "chi tiết"
                )
                  ? "Xem chi tiết ▾"
                  : "Inspect stage ▾";
            }
          });

          stageCards.forEach((card, idx) => {
            if (idx.toString() === targetIdx) {
              card.classList.remove("hidden");
              card.classList.add("block");
            } else {
              card.classList.add("hidden");
              card.classList.remove("block");
            }
          });
        });
      });
    });
  }

  // Safe binding to Astro lifecycle
  document.addEventListener("astro:page-load", setupCircuitInteractions);
</script>
