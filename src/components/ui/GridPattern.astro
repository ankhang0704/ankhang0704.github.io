---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "", size = 40 } = Astro.props;
---

<div
  class={`grid-pattern-container pointer-events-none absolute inset-0 overflow-hidden ${className}`}
  aria-hidden="true"
>
  <!-- Precision Blueprint Grid Lines -->
  <svg
    class="absolute inset-0 h-full w-full stroke-black/[0.04] dark:stroke-white/[0.04]"
    width="100%"
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern
        id="blueprint-grid-pattern"
        width={size}
        height={size}
        patternUnits="userSpaceOnUse"
      >
        <path d={`M.5 ${size}V.5H${size}`} fill="none" stroke-dasharray="2 4" />
      </pattern>
    </defs>
    <rect
      width="100%"
      height="100%"
      stroke-width="0"
      fill="url(#blueprint-grid-pattern)"
    />
  </svg>

  <!-- Interactive Cursor Spotlight Glow -->
  <div class="grid-pattern-glow absolute inset-0 opacity-0 transition-opacity duration-300 pointer-events-none"></div>
</div>

<script>
  function initGridPattern() {
    const containers = document.querySelectorAll<HTMLElement>(
      ".grid-pattern-container"
    );
    containers.forEach((container) => {
      const parent = container.parentElement;
      const glow = container.querySelector<HTMLElement>(".grid-pattern-glow");
      if (!parent || !glow) return;

      parent.addEventListener("mousemove", (e) => {
        const rect = parent.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        glow.style.opacity = "1";
        glow.style.background = `radial-gradient(350px circle at ${x}px ${y}px, rgba(125, 125, 125, 0.08), transparent 70%)`;
      });

      parent.addEventListener("mouseleave", () => {
        glow.style.opacity = "0";
      });
    });
  }

  initGridPattern();
  document.addEventListener("astro:page-load", initGridPattern);
</script>
