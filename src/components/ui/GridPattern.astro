---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 40 } = Astro.props;
---

<div
  class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`}
  aria-hidden="true"
>
  <svg
    class="absolute inset-0 h-full w-full stroke-black/[0.04] dark:stroke-white/[0.04]"
    width="100%"
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern
        id="engineering-grid-pattern"
        width={size}
        height={size}
        patternUnits="userSpaceOnUse"
      >
        <path
          d={`M ${size} 0 L 0 0 0 ${size}`}
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#engineering-grid-pattern)"></rect>
  </svg>
</div>
