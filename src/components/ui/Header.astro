---
import { getLocalizedPath } from "../../i18n/utils";

interface Props {
  lang?: "en" | "vi";
  currentPath?: string;
}

const { lang = "en", currentPath } = Astro.props;
const pathname = currentPath || Astro.url.pathname;
const isVi = lang === "vi";
const isHome = pathname === "/" || pathname === "/vi" || pathname === "/vi/";

// Calculate alternate language link cleanly using centralized utility
const targetLangHref = getLocalizedPath(pathname, isVi ? "en" : "vi");

const homeHref = isVi ? "/vi/" : "/";
const aboutHref = isHome ? "#about" : isVi ? "/vi/#about" : "/#about";
const workHref = isHome ? "#projects" : isVi ? "/vi/#projects" : "/#projects";
const skillsHref = isHome ? "#skills" : isVi ? "/vi/#skills" : "/#skills";
const expHref = isHome
  ? "#experience"
  : isVi
    ? "/vi/#experience"
    : "/#experience";
const projectsHref = isVi ? "/vi/projects/" : "/projects/";

const isProjectsPage = pathname.includes("/projects");

const links = [
  {
    href: aboutHref,
    label: isVi ? "Tóm tắt" : "Summary",
    section: "about",
    active: false,
    isRoute: false,
  },
  {
    href: workHref,
    label: isVi ? "Nổi bật" : "Work",
    section: "projects",
    active: false,
    isRoute: false,
  },
  {
    href: skillsHref,
    label: isVi ? "Kỹ năng" : "Skills",
    section: "skills",
    active: false,
    isRoute: false,
  },
  {
    href: expHref,
    label: isVi ? "Kinh nghiệm" : "Experience",
    section: "experience",
    active: false,
    isRoute: false,
  },
  {
    href: projectsHref,
    label: isVi ? "Dự án" : "Projects",
    section: "projects-index",
    active: isProjectsPage,
    isRoute: true,
  },
];
---

<header
  id="navbar"
  transition:name="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-black/10 dark:border-white/10 bg-bgLight/85 dark:bg-bgDark/85 backdrop-blur-md transition-colors duration-200"
>
  <div class="container mx-auto flex h-12 w-full min-w-0 items-center justify-between gap-4 px-6 md:px-8">
    <!-- Typographic Logo KHANG (0px geometry, aligned cleanly with hero & content edges) -->
    <a
      href={homeHref}
      class="min-w-0 shrink-0 font-display text-xl font-bold tracking-tighter whitespace-nowrap text-black dark:text-white hover:opacity-70 transition-opacity select-none"
      aria-label="An Khang — Home"
    >
      KHANG
    </a>

    <!-- Right Editorial Navigation & Controls -->
    <div class="flex items-center gap-4 lg:gap-7">
      <nav
        aria-label={isVi ? "Điều hướng chính" : "Main navigation"}
        class="hidden md:flex items-center gap-5 lg:gap-7"
      >
        {links.map((link) => (
          <a
            href={link.href}
            data-section={link.section}
            aria-current={link.active ? "page" : undefined}
            class={`nav-link hover-underline group inline-flex items-center gap-1.5 font-sans text-xs font-medium uppercase tracking-[0.14em] whitespace-nowrap transition-colors duration-200 ${
              link.active
                ? "active text-black dark:text-white font-semibold"
                : "text-black/65 dark:text-white/65 hover:text-black dark:hover:text-white"
            }`}
          >
            <span
              aria-hidden="true"
              class={`inline-block w-1.5 h-1.5 bg-current transition-[opacity,transform] duration-200 ${
                link.active
                  ? "opacity-100 scale-100"
                  : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"
              }`}
            />
            <span>{link.label}</span>
            {link.isRoute && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="11"
                height="11"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="opacity-55 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            )}
          </a>
        ))}
      </nav>

      <!-- Subtle Hairline Divider (Desktop) -->
      <span
        class="hidden md:block h-4 w-px bg-black/15 dark:bg-white/15 shrink-0"
        aria-hidden="true"
      />

      <!-- Utility Controls (44px touch targets inside 48px slim header) -->
      <div class="flex shrink-0 items-center gap-1 sm:gap-2">
        <!-- Language Switch (Native View Transition Link) -->
        <a
          href={targetLangHref}
          data-lang-switch
          data-astro-prefetch="load"
          class="flex h-11 min-w-10 px-2 items-center justify-center font-mono text-xs font-bold uppercase tracking-widest text-black/80 dark:text-white/80 hover:text-black dark:hover:text-white hover:opacity-55 active:scale-95 transition-[opacity,transform,color] duration-150"
          aria-label={isVi ? "Switch to English" : "Chuyển sang tiếng Việt"}
        >
          {isVi ? "EN" : "VI"}
        </a>

        <!-- Dark / Light Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="group flex h-11 w-10 items-center justify-center text-black/80 dark:text-white/80 hover:text-black dark:hover:text-white active:scale-90 transition-[color,transform] duration-150"
          aria-label={
            isVi
              ? "Chuyển đổi giao diện sáng / tối"
              : "Toggle dark / light mode"
          }
        >
          <!-- Moon Icon (Light Mode) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="block dark:hidden transition-transform duration-300 group-hover:-rotate-12"
            aria-hidden="true"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          <!-- Sun Icon (Dark Mode) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden dark:block transition-transform duration-500 group-hover:rotate-90"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </button>

        <!-- Mobile Menu Toggle Button (Swaps Hamburger <-> X while Header stays pinned) -->
        <button
          id="mobile-menu-open"
          type="button"
          data-label-open={isVi ? "Mở menu điều hướng" : "Open navigation menu"}
          data-label-close={
            isVi ? "Đóng menu điều hướng" : "Close navigation menu"
          }
          class="flex md:hidden h-11 w-10 items-center justify-center text-black dark:text-white hover:opacity-65 active:scale-90 transition-[opacity,transform] duration-150"
          aria-label={isVi ? "Mở menu điều hướng" : "Open navigation menu"}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mobile-icon-open block"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mobile-icon-close hidden"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 1px Scroll Progress Indicator Overlaid Directly on Bottom Border -->
  <div
    id="scroll-progress-bar"
    aria-hidden="true"
    class="scroll-progress pointer-events-none absolute -bottom-[1px] left-0 right-0 h-[1px] origin-left bg-black dark:bg-white"
  ></div>
</header>

<!-- Attached Mobile Navigation Dropdown (Keeps 48px Header Anchored at Top) -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label={isVi ? "Menu điều hướng" : "Navigation menu"}
  class="fixed inset-x-0 top-[49px] bottom-0 z-40 md:hidden opacity-0 pointer-events-none transition-opacity duration-200"
>
  <div
    id="mobile-menu-backdrop"
    class="absolute inset-0 bg-black/35 dark:bg-black/60 backdrop-blur-[2px]"
    aria-hidden="true"
  ></div>

  <div class="relative border-b border-black/15 dark:border-white/15 bg-bgLight/95 dark:bg-bgDark/95 backdrop-blur-md max-h-[calc(100dvh-49px)] overflow-y-auto">
    <nav
      aria-label={isVi ? "Menu di động" : "Mobile navigation"}
      class="container mx-auto px-6 py-2 flex flex-col divide-y divide-black/10 dark:divide-white/10"
    >
      {links.map((link) => (
        <a
          href={link.href}
          data-section={link.section}
          aria-current={link.active ? "page" : undefined}
          class={`mobile-nav-link group flex min-h-12 items-center justify-between py-3 font-sans text-xs font-medium uppercase tracking-[0.15em] transition-colors ${
            link.active
              ? "text-black dark:text-white font-semibold"
              : "text-black/75 dark:text-white/75 hover:text-black dark:hover:text-white"
          }`}
        >
          <span class="inline-flex items-center gap-2.5 transition-transform duration-200 group-hover:translate-x-1.5">
            <span
              aria-hidden="true"
              class={`inline-block w-1.5 h-1.5 bg-current transition-opacity duration-200 ${
                link.active
                  ? "opacity-100"
                  : "opacity-30 group-hover:opacity-100"
              }`}
            />
            <span>{link.label}</span>
          </span>
          <span
            class="font-mono text-xs opacity-40 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            {link.isRoute ? "↗" : "↓"}
          </span>
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  let lastFocusedElement: HTMLElement | null = null;

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains("dark");
    const nextTheme = isDark ? "light" : "dark";
    if (nextTheme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
    try {
      localStorage.setItem("theme", nextTheme);
    } catch (e) {}
  }

  function openMenu() {
    const mobileMenu = document.getElementById("mobile-menu");
    const menuToggleBtn = document.getElementById("mobile-menu-open");
    if (!mobileMenu || !menuToggleBtn) return;

    lastFocusedElement = document.activeElement as HTMLElement | null;
    mobileMenu.classList.add("active", "opacity-100", "pointer-events-auto");
    mobileMenu.classList.remove("opacity-0", "pointer-events-none");
    mobileMenu.setAttribute("aria-hidden", "false");
    document.body.classList.add("body-lock");

    menuToggleBtn.setAttribute("aria-expanded", "true");
    const closeLabel = menuToggleBtn.dataset.labelClose;
    if (closeLabel) menuToggleBtn.setAttribute("aria-label", closeLabel);

    const firstLink = mobileMenu.querySelector<HTMLElement>("a[href]");
    firstLink?.focus();
  }

  function closeMenu(restoreFocus = true) {
    const mobileMenu = document.getElementById("mobile-menu");
    const menuToggleBtn = document.getElementById("mobile-menu-open");
    if (!mobileMenu) return;

    mobileMenu.classList.remove("active", "opacity-100", "pointer-events-auto");
    mobileMenu.classList.add("opacity-0", "pointer-events-none");
    mobileMenu.setAttribute("aria-hidden", "true");
    document.body.classList.remove("body-lock");

    if (menuToggleBtn) {
      menuToggleBtn.setAttribute("aria-expanded", "false");
      const openLabel = menuToggleBtn.dataset.labelOpen;
      if (openLabel) menuToggleBtn.setAttribute("aria-label", openLabel);
    }

    if (restoreFocus) {
      if (
        lastFocusedElement &&
        typeof lastFocusedElement.focus === "function"
      ) {
        lastFocusedElement.focus();
      } else {
        menuToggleBtn?.focus();
      }
    }
  }

  function toggleMenu() {
    const mobileMenu = document.getElementById("mobile-menu");
    if (mobileMenu?.classList.contains("active")) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  const supportsScrollTimeline =
    typeof CSS !== "undefined" &&
    typeof CSS.supports === "function" &&
    CSS.supports("animation-timeline: scroll()") &&
    CSS.supports("animation-range: 0% 100%");

  let progressBarEl: HTMLElement | null = null;
  let cachedMaxScroll = 0;
  let lastScrollProgress = -1;

  function updateScrollProgress() {
    if (supportsScrollTimeline) return;
    if (!progressBarEl || !progressBarEl.isConnected) {
      progressBarEl = document.getElementById("scroll-progress-bar");
    }
    if (!progressBarEl) return;

    const scrollY = window.scrollY;
    const progress =
      cachedMaxScroll > 0
        ? Math.min(1, Math.max(0, scrollY / cachedMaxScroll))
        : 0;

    if (progress !== lastScrollProgress) {
      lastScrollProgress = progress;
      progressBarEl.style.transform = `scaleX(${progress})`;
    }
  }

  function syncScrollMetrics() {
    if (supportsScrollTimeline) return;
    progressBarEl = document.getElementById("scroll-progress-bar");
    cachedMaxScroll = Math.max(
      0,
      document.documentElement.scrollHeight - window.innerHeight
    );
    lastScrollProgress = -1;
    updateScrollProgress();
  }

  // Register fallback scroll & metric listeners ONLY when CSS scroll-timeline is unsupported
  if (
    typeof window !== "undefined" &&
    !supportsScrollTimeline &&
    !(window as any).__headerScrollBound
  ) {
    window.addEventListener("scroll", updateScrollProgress, { passive: true });
    window.addEventListener("resize", syncScrollMetrics, { passive: true });
    window.visualViewport?.addEventListener("resize", syncScrollMetrics, {
      passive: true,
    });
    if (typeof ResizeObserver !== "undefined") {
      const resizeObserver = new ResizeObserver(syncScrollMetrics);
      resizeObserver.observe(document.documentElement);
    }
    (window as any).__headerScrollBound = true;
  }

  function setupHeader() {
    const navbar = document.getElementById("navbar");
    const themeToggle = document.getElementById("theme-toggle");
    const menuToggleBtn = document.getElementById("mobile-menu-open");

    // Sync scroll progress bar immediately on page load/swap (fallback path)
    syncScrollMetrics();

    // Guard navbar controls from multi-attachment
    if (navbar && navbar.dataset.initialized !== "true") {
      navbar.dataset.initialized = "true";
      themeToggle?.addEventListener("click", toggleTheme);
      menuToggleBtn?.addEventListener("click", toggleMenu);
    }

    // Bind mobile menu elements across page swaps (as #mobile-menu is outside preserved navbar)
    const mobileMenu = document.getElementById("mobile-menu");
    if (mobileMenu && mobileMenu.dataset.menuInitialized !== "true") {
      mobileMenu.dataset.menuInitialized = "true";
      const backdrop = document.getElementById("mobile-menu-backdrop");
      const mobileLinks = mobileMenu.querySelectorAll("a");

      backdrop?.addEventListener("click", () => closeMenu());
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => closeMenu(false));
      });
    }
  }

  // Focus trap & Escape key handler for mobile dropdown (includes header toggle button)
  if (typeof window !== "undefined" && !(window as any).__headerKeyBound) {
    document.addEventListener("keydown", (e) => {
      const mobileMenu = document.getElementById("mobile-menu");
      if (!mobileMenu || !mobileMenu.classList.contains("active")) return;

      if (e.key === "Escape") {
        closeMenu();
        return;
      }

      if (e.key === "Tab") {
        const menuToggleBtn = document.getElementById("mobile-menu-open");
        const menuLinks = Array.from(
          mobileMenu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        );
        const focusable = menuToggleBtn
          ? [menuToggleBtn, ...menuLinks]
          : menuLinks;
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Preserve scroll position and freeze scramble/counter state across language toggle
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("[data-lang-switch]");
      if (target) {
        sessionStorage.setItem("lang_switch_scroll", window.scrollY.toString());
        sessionStorage.setItem("lang_switch_freeze_anim", "true");
      }
    });

    document.addEventListener("astro:after-swap", () => {
      const savedY = sessionStorage.getItem("lang_switch_scroll");
      if (savedY !== null) {
        sessionStorage.removeItem("lang_switch_scroll");
        window.scrollTo({ top: parseInt(savedY, 10), behavior: "instant" });
      }
      setupHeader();
    });

    document.addEventListener("astro:page-load", () => {
      setTimeout(() => {
        sessionStorage.removeItem("lang_switch_freeze_anim");
      }, 100);
    });

    document.addEventListener("astro:before-swap", () => {
      closeMenu(false);
    });

    document.addEventListener("astro:page-load", setupHeader);
    (window as any).__headerKeyBound = true;
  }
</script>
