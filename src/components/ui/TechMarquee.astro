---
interface Props {
  items?: string[];
  speedSeconds?: number;
  class?: string;
}

const DEFAULT_TECH = [
  "Flutter",
  "Django",
  "Python",
  "TypeScript",
  "Tailwind CSS",
  "Cloudflare Workers",
  "Firebase",
  "SQLite",
  "Docker",
  "IT Helpdesk",
];

const {
  items = DEFAULT_TECH,
  speedSeconds = 35,
  class: className = "",
} = Astro.props;

// Duplicate array 4 times to ensure seamless infinite CSS looping across any viewport width (including 4K / ultrawide)
const duplicated = [...items, ...items, ...items, ...items];
---

<div
  data-marquee-root
  class={`group relative overflow-hidden border-y border-black/10 bg-cardLight/60 py-4 dark:border-white/10 dark:bg-cardDark/60 select-none ${className}`}
  aria-label="Technologies and competencies ticker"
>
  <div
    data-marquee-track
    class="flex w-max motion-reduce:animate-none motion-reduce:transform-none animate-marquee group-hover:[animation-play-state:paused]"
    style={`animation-duration: ${speedSeconds}s;`}
  >
    {duplicated.map((tech) => (
      <div class="flex items-center space-x-6 px-6 font-mono text-xs uppercase tracking-[0.25em] text-black/70 dark:text-white/70">
        <span class="font-semibold transition-colors duration-200 group-hover:text-black dark:group-hover:text-white">
          {tech}
        </span>
        <span
          class="inline-block h-1.5 w-1.5 bg-black/30 dark:bg-white/30"
          aria-hidden="true"
        />
      </div>
    ))}
  </div>
</div>

<script>
  const activeObservers = new Set<IntersectionObserver>();

  function cleanupMarquees() {
    activeObservers.forEach((observer) => observer.disconnect());
    activeObservers.clear();
  }

  function initMarquees() {
    cleanupMarquees();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const roots = document.querySelectorAll<HTMLElement>("[data-marquee-root]");
    if (!roots.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const track = entry.target.querySelector<HTMLElement>(
          "[data-marquee-track]"
        );
        if (track) {
          track.style.animationPlayState = entry.isIntersecting ? "" : "paused";
        }
      });
    });

    activeObservers.add(observer);
    roots.forEach((root) => observer.observe(root));
  }

  document.addEventListener("astro:before-swap", cleanupMarquees);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMarquees, { once: true });
  } else {
    initMarquees();
  }
  document.addEventListener("astro:after-swap", initMarquees);
</script>
