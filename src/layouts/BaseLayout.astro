---
import { ClientRouter } from "astro:transitions";
import { getLocalizedPath } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "vi";
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "An Khang | Software Developer",
  description = "An Khang — Software Developer building web, mobile, and automation tools with hands-on IT support experience.",
  lang = "en",
  ogImage = "/icon.png",
  canonicalUrl,
} = Astro.props;

const siteUrl = "https://ankhang0704.pages.dev";

// Bilingual alternate paths with guaranteed trailing slashes via central utility
const enPath = getLocalizedPath(Astro.url.pathname, "en");
const viPath = getLocalizedPath(Astro.url.pathname, "vi");
const enHref = new URL(enPath, siteUrl).href;
const viHref = new URL(viPath, siteUrl).href;

// Canonical URL calculation
const canonical = canonicalUrl || (lang === "vi" ? viHref : enHref);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "An Khang",
  jobTitle: "Software Developer",
  knowsAbout: [
    "Web Development",
    "Mobile Development",
    "Automation",
    "IT Support",
    "Django",
    "Flutter",
  ],
  email: "mailto:ankhang.nguyen0704@gmail.com",
  url: siteUrl,
  sameAs: [
    "https://github.com/ankhang0704",
    "https://www.linkedin.com/in/ankhang0704/",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Multilingual Alternates -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="vi" href={viHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:site_name" content="An Khang Portfolio" />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Favicon Links (AK Monogram) -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Astro 5 ClientRouter for View Transitions -->
    <ClientRouter />

    <!-- Zero-FOUC Inline Theme Script -->
    <script is:inline>
      function applyTheme() {
        try {
          var s = localStorage.getItem("theme");
          var d =
            s === "dark" ||
            (!s && window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (d) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <!-- Scoped Smooth Scroll for In-Page Anchor Links (Zero-Lag Route Transitions) -->
    <script is:inline>
      document.addEventListener("click", function (e) {
        var a =
          e.target && e.target.closest
            ? e.target.closest('a[href^="#"]')
            : null;
        if (!a) return;
        var hash = a.getAttribute("href");
        if (!hash || hash.length <= 1) return;
        var targetId = hash.slice(1);
        var target = document.getElementById(targetId);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "auto"
              : "smooth",
          });
          target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });
          history.pushState(null, "", hash);
        }
      });
    </script>

    <!-- Schema.org Person JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-bgLight text-textLight dark:bg-bgDark dark:text-textDark font-sans relative overflow-x-hidden min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[200] focus:border focus:border-black focus:bg-bgLight focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:uppercase focus:tracking-widest dark:focus:border-white dark:focus:bg-bgDark"
    >
      Skip to content
    </a>

    <slot />

    <!-- Global Copy Email Toast Container (Singleton) -->
    <div
      id="copy-email-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-20 left-1/2 -translate-x-1/2 md:bottom-24 md:right-8 md:left-auto md:translate-x-0 z-[100] border border-black dark:border-white bg-bgLight dark:bg-bgDark p-4 flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
    >
      <div
        class="w-2 h-2 bg-black dark:bg-white shrink-0"
        aria-hidden="true"
      ></div>
      <span
        id="copy-email-toast-text"
        class="text-xs font-mono tracking-wider font-bold"
      ></span>
    </div>
  </body>
</html>
