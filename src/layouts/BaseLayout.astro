---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import { getLocalizedPath } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "vi";
  ogImage?: string;
  ogImageAlt?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title = "An Khang | Software Developer",
  description = "An Khang — Software Developer building web, mobile, and automation tools with hands-on IT support experience.",
  lang = "en",
  ogImage = "/og-card.png",
  ogImageAlt = "Nguyen An Khang — Software Developer Portfolio",
  canonicalUrl,
  noindex = false,
} = Astro.props;

const isDefaultOg = ogImage === "/og-card.png";
const isWebpCover = ogImage.endsWith(".webp");
const ogWidth = isDefaultOg ? "1200" : isWebpCover ? "1280" : undefined;
const ogHeight = isDefaultOg ? "630" : isWebpCover ? "801" : undefined;

const siteUrl = "https://ankhang0704.pages.dev";

// Bilingual alternate paths with guaranteed trailing slashes via central utility
const enPath = getLocalizedPath(Astro.url.pathname, "en");
const viPath = getLocalizedPath(Astro.url.pathname, "vi");
const enHref = new URL(enPath, siteUrl).href;
const viHref = new URL(viPath, siteUrl).href;

// Canonical URL calculation
const canonical = canonicalUrl || (lang === "vi" ? viHref : enHref);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "An Khang",
  jobTitle: "Software Developer",
  knowsAbout: [
    "Web Development",
    "Mobile Development",
    "Automation",
    "IT Support",
    "Django",
    "Flutter",
  ],
  email: "mailto:ankhang.nguyen0704@gmail.com",
  url: siteUrl,
  sameAs: [
    "https://github.com/ankhang0704",
    "https://www.linkedin.com/in/ankhang0704/",
  ],
};
---

<!doctype html>
<html
  lang={lang}
  class="bg-bgLight text-textLight dark:bg-bgDark dark:text-textDark"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" id="theme-color-meta" content="#fafafa" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Multilingual Alternates -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="vi" href={viHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    {ogWidth && <meta property="og:image:width" content={ogWidth} />}
    {ogHeight && <meta property="og:image:height" content={ogHeight} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="An Khang Portfolio" />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon Links (AK Monogram) -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Astro 5 ClientRouter for View Transitions -->
    <ClientRouter />

    <!-- Zero-FOUC Inline Theme Script -->
    <script is:inline>
      (function () {
        function getIsDark() {
          var s = null;
          try {
            s = localStorage.getItem("theme");
          } catch (e) {
            if (document.documentElement.classList.contains("dark")) {
              return true;
            }
          }
          return (
            s === "dark" ||
            (!s && window.matchMedia("(prefers-color-scheme: dark)").matches)
          );
        }

        function syncTheme(doc, isDark) {
          doc.documentElement.classList.toggle("dark", isDark);
          var meta = doc.getElementById("theme-color-meta");
          if (meta) {
            meta.setAttribute("content", isDark ? "#0a0a0a" : "#fafafa");
          }
        }

        function applyTheme() {
          syncTheme(document, getIsDark());
        }

        applyTheme();

        if (!window.__themeListenersBound) {
          document.addEventListener("astro:before-swap", function (ev) {
            var isDark = document.documentElement.classList.contains("dark");
            if (ev && ev.newDocument) {
              syncTheme(ev.newDocument, isDark);
            }
          });
          document.addEventListener("astro:after-swap", applyTheme);
          window.__themeListenersBound = true;
        }
      })();
    </script>

    <!-- Scoped Smooth Scroll for In-Page Anchor Links (Zero-Lag Route Transitions) -->
    <script is:inline>
      (function () {
        if (window.__hashScrollBound) return;
        window.__hashScrollBound = true;
        document.addEventListener("click", function (e) {
          var a =
            e.target && e.target.closest
              ? e.target.closest('a[href^="#"]')
              : null;
          if (!a) return;
          var hash = a.getAttribute("href");
          if (!hash || hash.length <= 1) return;
          var targetId = hash.slice(1);
          var target = document.getElementById(targetId);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
                .matches
                ? "auto"
                : "smooth",
            });
            target.setAttribute("tabindex", "-1");
            target.focus({ preventScroll: true });
            history.pushState(history.state, "", hash);
          }
        });
      })();
    </script>

    <!-- Schema.org Person JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-bgLight text-textLight dark:bg-bgDark dark:text-textDark font-sans relative overflow-x-clip min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[200] focus:border focus:border-black focus:bg-bgLight focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:uppercase focus:tracking-widest dark:focus:border-white dark:focus:bg-bgDark"
    >
      Skip to content
    </a>

    <slot />

    <!-- Global Copy Email Toast Container (Singleton) -->
    <div
      id="copy-email-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-20 left-1/2 -translate-x-1/2 md:bottom-24 md:right-8 md:left-auto md:translate-x-0 z-[100] border border-black dark:border-white bg-bgLight dark:bg-bgDark p-4 flex items-center gap-3 transition-[opacity,transform] duration-300 opacity-0 pointer-events-none translate-y-4"
    >
      <div
        class="w-2 h-2 bg-black dark:bg-white shrink-0"
        aria-hidden="true"
      ></div>
      <span
        id="copy-email-toast-text"
        class="text-xs font-mono tracking-wider font-bold"
      ></span>
    </div>
  </body>
</html>
