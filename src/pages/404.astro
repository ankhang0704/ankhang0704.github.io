---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import MagneticButton from "../components/interactive/MagneticButton.astro";

const title = "404 — Page Not Found | An Khang";
const description =
  "The requested page could not be found. Trang bạn đang tìm kiếm không tồn tại.";
---

<BaseLayout title={title} description={description} lang="en">
  <Header lang="en" />

  <main
    id="main-content"
    class="min-h-[75vh] flex items-center justify-center pt-24 pb-16 px-6"
  >
    <div class="max-w-xl w-full border border-black/10 dark:border-white/10 bg-cardLight dark:bg-cardDark p-8 sm:p-12 text-center space-y-6">
      <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] opacity-60">
        <span
          class="w-2 h-2 bg-black dark:bg-white inline-block"
          aria-hidden="true"
        ></span>
        <span>ERROR // 404</span>
      </div>

      <h1 class="font-display text-6xl sm:text-8xl font-bold tracking-tighter text-black dark:text-white">
        404
      </h1>

      <div class="space-y-2">
        <p class="font-display text-xl sm:text-2xl font-bold text-black dark:text-white">
          Page Not Found · Không tìm thấy trang
        </p>
        <p class="font-light text-sm sm:text-base opacity-75 max-w-md mx-auto leading-relaxed">
          The link you followed may be broken or the page may have been moved.
          Đường dẫn có thể đã bị thay đổi hoặc không tồn tại.
        </p>
      </div>

      <div class="pt-6 flex flex-wrap justify-center gap-4">
        <MagneticButton
          href="/"
          class="border border-black bg-black text-white dark:border-white dark:bg-white dark:text-black px-6 py-3 text-xs font-bold uppercase tracking-widest hover:opacity-85 transition-opacity"
        >
          Return Home (EN)
        </MagneticButton>
        <MagneticButton
          href="/vi/"
          class="border border-black/20 dark:border-white/20 text-black dark:text-white px-6 py-3 text-xs font-bold uppercase tracking-widest hover:border-black dark:hover:border-white transition-colors"
        >
          Trang chủ (VI)
        </MagneticButton>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</BaseLayout>
