<BaseLayout title="An Khang | Lập trình viên" lang="vi" description="An Khang — Lập trình viên phát triển web, mobile và tự động hóa với kinh nghiệm thực tế về IT support.">
  <main id="main-content" class="flex flex-col items-center justify-center min-h-[80vh] px-6 text-center">
    <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight mb-4">
      An Khang
    </h1>
    <p class="font-sans text-lg sm:text-xl text-neutral-600 dark:text-neutral-400 max-w-lg mb-8">
      Lập trình viên phát triển web, mobile và tự động hóa với kinh nghiệm thực tế về IT support.
    </p>
  </main>
</BaseLayout>
